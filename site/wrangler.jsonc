{
  // Pages project "celticcoo". This file becomes the source of truth for
  // Functions bindings on the next `wrangler pages deploy`. It does not change
  // DNS. Pages cannot hold a send_email binding. Outbound mail is the private
  // celticcoo-mailer Worker (workers/mailer/), called through MAILER.
  //
  // INTAKE_DB is the private booking database. database_id stays a placeholder
  // in git. The deploy workflow copies the GitHub secret D1_DATABASE_ID over
  // it for that deploy only. If the secret is missing, the workflow removes
  // this binding so the rest of the site can still deploy.
  // Apply site/migrations/0004_intake_guard.sql before relying on the cutoff
  // switch. The form still accepts bookings if that table is missing.
  // The same optional GUARD_* and OUTBOUND_DAILY_CAP vars as the inbound
  // Worker override the site-pack defaults. Leave them unset unless a
  // default is wrong. Do not put a secret in a var.
  //
  // TURNSTILE_HOSTNAMES is the production allowlist checked against siteverify.
  // Do not add localhost or 127.0.0.1. TURNSTILE_SECRET is a Pages secret set
  // with `wrangler pages secret put`, not a var in this file.
  "name": "celticcoo",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-23",
  "services": [
    {
      "binding": "MAILER",
      "service": "celticcoo-mailer"
    }
  ],
  "d1_databases": [
    {
      "binding": "INTAKE_DB",
      "database_name": "celticcoo-intake",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TURNSTILE_HOSTNAMES": "celticcoo.ca,www.celticcoo.ca"
  }
}
