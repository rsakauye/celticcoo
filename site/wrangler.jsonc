{
  // Pages project "celticcoo". This file becomes the source of truth for
  // Functions bindings on the next `wrangler pages deploy`. It does not change
  // DNS. Pages cannot hold a send_email binding. Outbound mail is the private
  // celticcoo-mailer Worker (workers/mailer/), called through MAILER.
  "name": "celticcoo",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-23",
  "services": [
    {
      "binding": "MAILER",
      "service": "celticcoo-mailer"
    }
  ]
}
