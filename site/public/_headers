# Cloudflare Pages headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self)
  X-Frame-Options: DENY
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self' https://app.kit.com; base-uri 'self'; frame-ancestors 'none'; object-src 'none'

/events.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/events/*.ics
  Content-Type: text/calendar; charset=utf-8
  Content-Disposition: inline
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/rss.xml
  Cache-Control: public, max-age=3600

# Hashed build assets never change at the same URL: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/coo.svg
  Cache-Control: public, max-age=604800

/tartans/*
  Cache-Control: public, max-age=604800

/tartan-fraser-of-lovat.svg
  Cache-Control: public, max-age=604800

/img/*
  Cache-Control: public, max-age=604800

/og.png
  Cache-Control: public, max-age=604800

# Documents revalidate. There is no service worker; a cached /groups/ page was the stale-script risk.
/groups
  Cache-Control: public, max-age=0, must-revalidate

/groups/
  Cache-Control: public, max-age=0, must-revalidate

# Keep Cloudflare Pages preview hosts out of search (canonical is https://celticcoo.ca)
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Drum practice and the tuner use the microphone. Only this site may ask for it.
/drum/*
  Permissions-Policy: microphone=(self)

/tune/*
  Permissions-Policy: microphone=(self)
