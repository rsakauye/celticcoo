---
import { u } from '../lib/site.js';
import { defaultTartan, pickerOrder, settTileImage } from '../lib/ceilidhTartans.js';

const { variant = 'corner' } = Astro.props;
const choices = pickerOrder();
const current = defaultTartan();
const headingId = `tartan-heading-${variant}`;
---
<div class:list={['tartan-pick', variant]} data-tartan-picker={variant}>
  <h2 class="tartan-heading" id={headingId}>Pick Ceilidh's tartan</h2>
  <div class="tartan-row" data-tartan-row role="group" aria-labelledby={headingId}>
    {choices.map((tartan) => (
      <button
        type="button"
        class="tartan-tile"
        data-tartan-choice={tartan.slug}
        data-fling={u(tartan.fling)}
        data-ears={u(tartan.ears)}
        aria-pressed={tartan.slug === current.slug ? 'true' : 'false'}
      >
        <span class="tile" data-tartan-tile style={`background-image:${settTileImage(tartan)}`}></span>
        <span class="tartan-label">{tartan.name}</span>
      </button>
    ))}
  </div>
</div>

<script>
  import { applyTartan, readTartan, writeTartanId } from '../lib/ceilidhTartans.js';

  const storage = {
    getItem(key) {
      try { return localStorage.getItem(key); } catch { return null; }
    },
    setItem(key, value) {
      try { localStorage.setItem(key, value); } catch { /* this browser blocked storage */ }
    },
  };

  function paint(tartan) {
    const button = document.querySelector(`[data-tartan-choice="${tartan.slug}"]`);
    const dance = button?.getAttribute('data-fling');
    const ears = button?.getAttribute('data-ears');
    if (dance) document.querySelectorAll('[data-ceilidh-dance]').forEach((img) => { img.src = dance; });
    if (ears) document.querySelectorAll('[data-ceilidh-ears]').forEach((img) => { img.src = ears; });
    applyTartan(tartan, { choices: document.querySelectorAll('[data-tartan-choice]') });
  }

  // Move the selected tile into the strip. Do not scroll the page.
  function revealSelected(picker) {
    const row = picker.querySelector('[data-tartan-row]');
    const selected = row?.querySelector('[aria-pressed="true"]');
    if (!row || !selected) return;
    const x = window.scrollX;
    const y = window.scrollY;
    try { selected.scrollIntoView({ inline: 'nearest', block: 'nearest' }); } catch { /* keep the page put */ }
    if (window.scrollX !== x || window.scrollY !== y) window.scrollTo(x, y);
  }

  document.querySelectorAll('[data-tartan-picker]').forEach((picker) => {
    picker.querySelectorAll('[data-tartan-choice]').forEach((choice) => {
      choice.addEventListener('click', () => {
        const tartan = writeTartanId(choice.getAttribute('data-tartan-choice'), storage);
        paint(tartan);
      });
    });
  });

  paint(readTartan(storage));
  document.querySelectorAll('[data-tartan-picker]').forEach(revealSelected);
</script>

<style>
  .tartan-pick {
    pointer-events: auto;
    color: #2B1D14;
  }
  .tartan-heading {
    margin: 0 0 8px;
    font-family: system-ui, sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    color: #2B1D14;
    text-align: center;
  }
  .tartan-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    justify-content: center;
    gap: 12px;
  }
  .tartan-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 56px;
    min-width: 48px;
    min-height: 70px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #2B1D14;
    font: inherit;
    cursor: pointer;
    scroll-snap-align: start;
    flex: none;
  }
  .tartan-tile:hover { transform: translateY(-2px); }
  .tile {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 4px;
    border: 1px solid rgba(31, 77, 58, .45);
    background-repeat: repeat;
    background-size: 50% 50%;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
  .tartan-tile[aria-pressed="true"] .tile,
  .tartan-tile:focus-visible .tile {
    outline: 3px solid #1F4D3A;
    outline-offset: 2px;
  }
  .tartan-tile:focus { outline: none; }
  .tartan-label {
    width: calc(100% + 12px);
    max-width: calc(56px + 12px);
    text-align: center;
    font: 600 13px/16px system-ui, sans-serif;
    color: #2B1D14;
    white-space: normal;
    overflow: visible;
  }
  .tartan-tile[aria-pressed="true"] .tartan-label { font-weight: 700; }
  .tartan-pick.corner {
    margin-top: 24px;
    padding-bottom: 32px;
  }
  .tartan-pick.tune {
    margin-top: 16px;
    width: 100%;
  }
  .tartan-pick.tune .tartan-row {
    justify-content: flex-start;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .tartan-pick.tune .tartan-row::-webkit-scrollbar { display: none; }
  @media (max-width: 719px) {
    .tartan-tile,
    .tile { width: 48px; }
    .tile { height: 48px; }
    .tartan-label { max-width: calc(48px + 12px); }
    .tartan-pick.corner {
      margin-top: 16px;
      padding: 0 16px 16px;
      width: 100%;
    }
    .tartan-pick.corner .tartan-row {
      justify-content: flex-start;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .tartan-pick.corner .tartan-row::-webkit-scrollbar { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tartan-tile:hover { transform: none; }
  }
  :global(html[data-a11y-motion=reduce]) .tartan-tile:hover { transform: none; }
</style>
