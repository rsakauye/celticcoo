---
import { u } from '../lib/site.js';
import { defaultTartan, pickerOrder, settTileImage } from '../lib/ceilidhTartans.js';

const { variant = 'corner' } = Astro.props;
const choices = pickerOrder();
const current = defaultTartan();
const panelId = `tartan-panel-${variant}`;
const headingId = `tartan-heading-${variant}`;
const chip = settTileImage(current);
---
<div class:list={['tartan-pick', variant]} data-tartan-picker={variant}>
  {variant === 'tune' && (
    <button type="button" class="tartan-trigger" data-tartan-open aria-expanded="false" aria-controls={panelId} aria-label="Pick Ceilidh's tartan">
      <span class="tartan-chip" data-tartan-chip style={`background-image:${chip}`}></span>
      <span>Ceilidh's tartan</span>
      <span class="tartan-caret" aria-hidden="true">▾</span>
    </button>
  )}
  <div class="tartan-backdrop" data-tartan-backdrop hidden></div>
  <div
    id={panelId}
    class="tartan-panel"
    data-tartan-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby={headingId}
    hidden
  >
    <div class="tartan-grab" aria-hidden="true"></div>
    <div class="tartan-head">
      <h2 id={headingId}>Pick Ceilidh's tartan</h2>
      <button type="button" class="tartan-close" data-tartan-close aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3.2 3.2 L12.8 12.8 M12.8 3.2 L3.2 12.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
        </svg>
      </button>
    </div>
    <div class="tartan-grid" data-tartan-grid role="group" aria-labelledby={headingId}>
      {choices.map((tartan) => (
        <button
          type="button"
          class="tartan-tile"
          data-tartan-choice={tartan.slug}
          data-fling={u(tartan.fling)}
          data-ears={u(tartan.ears)}
          aria-label={tartan.name}
          title={tartan.name}
          aria-pressed={tartan.slug === current.slug ? 'true' : 'false'}
        >
          <span class="tile" data-tartan-tile style={`background-image:${settTileImage(tartan)}`}></span>
          <span class="tartan-label">{tartan.short_label}</span>
        </button>
      ))}
    </div>
    <p class="tartan-current" data-tartan-current>{current.name}</p>
  </div>
</div>

<script>
  import { applyTartan, readTartan, settTileImage, writeTartanId } from '../lib/ceilidhTartans.js';

  const storage = {
    getItem(key) {
      try { return localStorage.getItem(key); } catch { return null; }
    },
    setItem(key, value) {
      try { localStorage.setItem(key, value); } catch { /* this browser blocked storage */ }
    },
  };

  const SHEET = '(max-width: 640px)';

  function sheet() {
    return window.matchMedia(SHEET).matches;
  }

  function reducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function triggerFor(panel) {
    return document.querySelector(`[aria-controls="${panel.id}"]`);
  }

  function backdropFor(panel) {
    return panel.parentElement?.querySelector('[data-tartan-backdrop]') || null;
  }

  function focusables(panel) {
    return [...panel.querySelectorAll('button')].filter((el) => !el.disabled && el.getClientRects().length);
  }

  function paint(tartan) {
    const button = document.querySelector(`[data-tartan-choice="${tartan.slug}"]`);
    const dance = button?.getAttribute('data-fling');
    const ears = button?.getAttribute('data-ears');
    if (dance) document.querySelectorAll('[data-ceilidh-dance]').forEach((img) => { img.src = dance; });
    if (ears) document.querySelectorAll('[data-ceilidh-ears]').forEach((img) => { img.src = ears; });
    applyTartan(tartan, { choices: document.querySelectorAll('[data-tartan-choice]') });
    const image = settTileImage(tartan);
    document.querySelectorAll('[data-tartan-chip]').forEach((el) => { el.style.backgroundImage = image; });
    document.querySelectorAll('[data-tartan-current]').forEach((el) => { el.textContent = tartan.name; });
  }

  function overlaps(a, b) {
    return a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;
  }

  function place(panel) {
    if (sheet()) {
      panel.style.left = '';
      panel.style.top = '';
      panel.style.right = '';
      panel.style.bottom = '';
      return;
    }
    const trigger = triggerFor(panel);
    const sprite = document.querySelector('[data-coo-stage]');
    const anchor = trigger && trigger.getClientRects().length ? trigger : sprite;
    if (!anchor) return;
    const tag = anchor.getBoundingClientRect();
    const width = panel.offsetWidth;
    const height = panel.offsetHeight;
    const min = 16;
    const maxLeft = Math.max(min, window.innerWidth - width - min);
    const maxTop = Math.max(min, window.innerHeight - height - min);
    const clamp = (left, top) => ({
      left: Math.min(Math.max(left, min), maxLeft),
      top: Math.min(Math.max(top, min), maxTop),
    });
    const area = (pos) => ({ left: pos.left, top: pos.top, right: pos.left + width, bottom: pos.top + height });
    const copy = [...document.querySelectorAll('.hero h1, .hero .lede, .hero .meet, .hero .stats')];
    const blockers = [...copy];
    if (sprite && sprite.getClientRects().length) blockers.push(sprite);
    const below = clamp(tag.right - width, tag.bottom + 8);
    const above = clamp(tag.right - width, tag.top - height - 8);
    const belowFits = tag.bottom + 8 + height <= window.innerHeight - min;
    const aboveFits = tag.top - height - 8 >= min;
    const ordered = [];
    if (belowFits) ordered.push(below);
    if (aboveFits) ordered.push(above);
    ordered.push(below, above, clamp(min, maxTop));
    let chosen = ordered.find((pos) => !blockers.some((el) => overlaps(area(pos), el.getBoundingClientRect()))) || above;
    if (copy.some((el) => overlaps(area(chosen), el.getBoundingClientRect()))) {
      const gutter = clamp(min, maxTop);
      if (!copy.some((el) => overlaps(area(gutter), el.getBoundingClientRect()))) chosen = gutter;
    }
    panel.style.right = 'auto';
    panel.style.bottom = 'auto';
    panel.style.left = `${Math.round(chosen.left)}px`;
    panel.style.top = `${Math.round(chosen.top)}px`;
  }

  let returnFocus = null;

  function focusReturn(panel) {
    const trigger = triggerFor(panel);
    const target = trigger && trigger.getClientRects().length ? trigger : returnFocus;
    if (target && typeof target.focus === 'function') target.focus();
  }

  function finishClose(panel) {
    if (panel.dataset.closing !== '1') return;
    panel.hidden = true;
    panel.classList.remove('is-open');
    panel.dataset.closing = '';
    const backdrop = backdropFor(panel);
    if (backdrop) backdrop.hidden = true;
  }

  function openPanel(panel, source) {
    document.querySelectorAll('[data-tartan-panel]').forEach((other) => {
      if (other !== panel && !other.hidden) closePanel(other, false);
    });
    const trigger = triggerFor(panel);
    returnFocus = source || trigger;
    panel.dataset.closing = '';
    panel.hidden = false;
    const backdrop = backdropFor(panel);
    if (backdrop) backdrop.hidden = !sheet() ? true : false;
    if (trigger) trigger.setAttribute('aria-expanded', 'true');
    panel.classList.remove('is-open');
    place(panel);
    panel.getBoundingClientRect();
    panel.classList.add('is-open');
    const selected = panel.querySelector('[aria-pressed="true"]');
    const first = selected || focusables(panel)[0];
    first?.focus();
  }

  function closePanel(panel, restore) {
    if (panel.hidden || panel.dataset.closing === '1') return;
    const trigger = triggerFor(panel);
    if (trigger) trigger.setAttribute('aria-expanded', 'false');
    panel.classList.remove('is-open');
    if (restore) focusReturn(panel);
    const animate = sheet() && !reducedMotion() && panel.dataset.closing !== '1';
    panel.dataset.closing = '1';
    if (!animate) {
      finishClose(panel);
      return;
    }
    const onEnd = (event) => {
      if (event.target !== panel) return;
      panel.removeEventListener('transitionend', onEnd);
      finishClose(panel);
    };
    panel.addEventListener('transitionend', onEnd);
    window.setTimeout(() => finishClose(panel), 280);
  }

  function togglePanel(panel, source) {
    if (panel.hidden) openPanel(panel, source);
    else closePanel(panel, true);
  }

  function openPanelEl() {
    return document.querySelector('[data-tartan-panel]:not([hidden])');
  }

  document.querySelectorAll('[data-tartan-picker]').forEach((picker) => {
    const panel = picker.querySelector('[data-tartan-panel]');
    picker.querySelectorAll('[data-tartan-choice]').forEach((choice) => {
      choice.addEventListener('click', () => {
        paint(writeTartanId(choice.getAttribute('data-tartan-choice'), storage));
      });
    });
    picker.querySelector('[data-tartan-close]')?.addEventListener('click', () => closePanel(panel, true));
    picker.querySelector('[data-tartan-backdrop]')?.addEventListener('click', () => closePanel(panel, true));
  });

  document.querySelectorAll('[data-tartan-open]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      const panel = document.getElementById(trigger.getAttribute('aria-controls'));
      if (panel) togglePanel(panel, trigger);
    });
  });

  const sprite = document.querySelector('[data-coo-toggle]');
  sprite?.addEventListener('click', () => {
    const panel = document.getElementById('tartan-panel-corner');
    if (panel && panel.hidden) openPanel(panel, sprite);
  });

  document.addEventListener('pointerdown', (event) => {
    const panel = openPanelEl();
    if (!panel) return;
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (panel.contains(target)) return;
    if (target.closest('[data-tartan-open]')) return;
    if (target.closest('[data-coo-toggle]')) return;
    closePanel(panel, true);
  });

  document.addEventListener('keydown', (event) => {
    const panel = openPanelEl();
    if (!panel) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      closePanel(panel, true);
      return;
    }
    const items = focusables(panel);
    if (!items.length) return;
    const index = items.indexOf(document.activeElement);
    if (event.key === 'Tab') {
      if (index < 0) {
        event.preventDefault();
        items[0].focus();
        return;
      }
      if (!event.shiftKey && index === items.length - 1) {
        event.preventDefault();
        items[0].focus();
      } else if (event.shiftKey && index === 0) {
        event.preventDefault();
        items[items.length - 1].focus();
      }
      return;
    }
    const tiles = items.filter((el) => el.hasAttribute('data-tartan-choice'));
    const tileIndex = tiles.indexOf(document.activeElement);
    if (tileIndex < 0) return;
    let next = tileIndex;
    if (event.key === 'ArrowRight') next = (tileIndex + 1) % tiles.length;
    else if (event.key === 'ArrowLeft') next = (tileIndex - 1 + tiles.length) % tiles.length;
    else if (event.key === 'ArrowDown') next = Math.min(tiles.length - 1, tileIndex + 4);
    else if (event.key === 'ArrowUp') next = Math.max(0, tileIndex - 4);
    else return;
    event.preventDefault();
    tiles[next].focus();
  });

  window.addEventListener('resize', () => {
    const panel = openPanelEl();
    if (panel) place(panel);
  });

  paint(readTartan(storage));
</script>

<style>
  .tartan-pick { pointer-events: none; color: #2B1D14; }
  .tartan-pick.corner {
    position: absolute;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    overflow: visible;
  }
  .tartan-backdrop {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgba(0, 0, 0, .35);
    pointer-events: auto;
  }
  .tartan-backdrop[hidden],
  .tartan-panel[hidden] { display: none !important; }
  .tartan-panel {
    position: fixed;
    z-index: 80;
    box-sizing: border-box;
    width: 324px;
    padding: 16px;
    background: #FFFDF8;
    border: 1px solid rgba(31, 77, 58, .2);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .18);
    color: #2B1D14;
    pointer-events: auto;
  }
  .tartan-grab { display: none; }
  .tartan-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 44px;
    margin: 0 0 12px;
  }
  .tartan-head h2 {
    margin: 0;
    font-family: system-ui, sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    color: #2B1D14;
  }
  .tartan-close {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #2B1D14;
    cursor: pointer;
  }
  .tartan-close svg { display: block; width: 16px; height: 16px; }
  .tartan-close:focus { outline: none; box-shadow: none; }
  .tartan-close:focus-visible {
    outline: 3px solid #1F4D3A;
    outline-offset: 2px;
  }
  .tartan-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 64px));
    column-gap: 12px;
    row-gap: 14px;
    width: calc(4 * 64px + 3 * 12px);
    max-width: 100%;
  }
  .tartan-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #2B1D14;
    font: inherit;
    cursor: pointer;
  }
  .tartan-tile:hover { transform: translateY(-2px); }
  .tartan-tile:focus { outline: none; box-shadow: none; }
  .tile {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 4px;
    border: 1px solid rgba(31, 77, 58, .45);
    background-repeat: repeat;
    background-size: 50% 50%;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
  .tartan-tile[aria-pressed="true"] .tile,
  .tartan-tile:focus-visible .tile {
    outline: 3px solid #1F4D3A;
    outline-offset: 2px;
  }
  .tartan-label {
    display: block;
    width: 100%;
    max-width: 100%;
    text-align: center;
    font: 600 12px/15px system-ui, sans-serif;
    color: #2B1D14;
    overflow-wrap: normal;
    word-break: normal;
    white-space: normal;
  }
  .tartan-tile[aria-pressed="true"] .tartan-label { font-weight: 700; }
  .tartan-current {
    margin: 12px 0 0;
    font: 400 13px/1.3 system-ui, sans-serif;
    color: #2B1D14;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tartan-pick.tune .tartan-trigger {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: 8px 0 0;
    padding: 0 .7rem;
    border: 2px solid var(--green, #1f4d3a);
    border-radius: 999px;
    background: var(--card, #fffdf8);
    color: var(--green, #1f4d3a);
    box-shadow: 0 1px 0 rgba(42, 29, 20, .12);
    font: 700 .72rem/1.2 system-ui, sans-serif;
    letter-spacing: .02em;
    cursor: pointer;
    pointer-events: auto;
  }
  .tartan-chip {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    flex: none;
    border-radius: 2px;
    border: 1px solid rgba(31, 77, 58, .45);
    background-repeat: repeat;
    background-size: 50% 50%;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
  .tartan-caret { margin-left: 4px; font-size: 10px; line-height: 1; }
  @media (min-width: 641px) {
    .tartan-backdrop { display: none !important; }
  }
  @media (max-width: 640px) {
    .tartan-panel {
      left: 0;
      right: 0;
      bottom: 0;
      top: auto;
      width: 100%;
      max-height: 60vh;
      overflow: auto;
      border-radius: 16px 16px 0 0;
      padding: 16px 16px calc(16px + env(safe-area-inset-bottom, 0px));
      transform: translateY(100%);
      transition: transform 200ms ease;
    }
    .tartan-panel.is-open { transform: translateY(0); }
    .tartan-grab {
      display: block;
      position: absolute;
      top: 8px;
      left: 50%;
      width: 36px;
      height: 4px;
      margin-left: -18px;
      border-radius: 999px;
      background: rgba(43, 29, 20, .28);
    }
    .tartan-grid {
      width: 100%;
      grid-template-columns: repeat(4, minmax(0, 64px));
      column-gap: calc((100% - 256px) / 3);
      row-gap: 14px;
      justify-content: start;
    }
    .tartan-grid .tile { width: 64px; height: 64px; }
  }
  @media (max-width: 640px) and (prefers-reduced-motion: reduce) {
    .tartan-panel {
      transform: none;
      opacity: 0;
      transition: opacity 200ms ease;
    }
    .tartan-panel.is-open { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tartan-tile:hover { transform: none; }
  }
  :global(html[data-a11y-motion=reduce]) .tartan-tile:hover { transform: none; }
</style>
