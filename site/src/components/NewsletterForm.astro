---
import { caslFooterText } from '../../../shared/casl/notice.js';
import { kitAction, u } from '../lib/site.js';
const { compact = false } = Astro.props;
const id = compact ? 'nl-email-footer' : 'nl-email';
---
{kitAction ? (
  <form action={kitAction} method="post" style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;margin-top:.4rem">
    <label for={id} class="sr-only">Email address</label>
    <input id={id} type="email" name="email_address" required placeholder="you@example.com" autocomplete="email" style="flex:1;min-width:200px" />
    <button class="btn" type="submit">{compact ? 'Subscribe' : 'Send me the Coo\'s Letter'}</button>
    {!compact && <p class="muted" style="flex-basis:100%;margin:.25rem 0 0">Free. One email every two weeks, on Tuesdays. Unsubscribe anytime.</p>}
    <p class="muted" style="flex-basis:100%;margin:.25rem 0 0;white-space:pre-wrap">{caslFooterText()}</p>
  </form>
) : (
  compact
    ? <span class="muted">Newsletter sign-up opens soon. Meanwhile, grab the <a href={u('events.ics')}>calendar feed</a>.</span>
    : <div><p style="margin:.2rem 0"><b>Sign-up opens soon.</b></p><p class="muted" style="margin:.2rem 0">Until then, subscribe to the <a href={u('events.ics')}>events calendar</a> or the <a href={u('rss.xml')}>RSS feed</a>.</p></div>
)}
