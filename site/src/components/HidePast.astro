<script is:inline>
  // The site is static; hide events that ended since the last build.
  (function () {
    var t = new Date(); var today = t.getFullYear() + '-' + String(t.getMonth() + 1).padStart(2, '0') + '-' + String(t.getDate()).padStart(2, '0');
    document.querySelectorAll('.ev[data-end]').forEach(function (el) { if (el.dataset.end < today) { el.hidden = true; el.dataset.past = '1'; } });
  })();
</script>
