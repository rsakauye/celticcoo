---
import { CATEGORY_EMOJI, COUNTRY_FLAG, FEATURES } from '../lib/data.js';
const { e } = Astro.props;
---
<article class="card ev" id={e.id} data-end={e.end_date} data-region={e.region} data-country={e.country} data-cat={e.category} data-features={(e.features || []).join(' ')}>
  <div class="ev-date">{e.when}</div>
  <h3 style="margin:.25rem 0 .35rem;font-size:1.15rem">{e.name}</h3>
  <div class="muted" style="margin-bottom:.45rem">{COUNTRY_FLAG[e.country] || ''} {e.city}, {e.regionLabel}{e.country !== 'Canada' && e.country !== e.regionLabel ? `, ${e.country}` : ''}</div>
  <span class="pill green">{CATEGORY_EMOJI[e.category]} {e.category}</span>
  {e.type !== e.category && <span class="pill">{e.type}</span>}
  {e.features && e.features.length > 0 && <div style="margin-top:.2rem">{e.features.map((f) => <a class="pill feat" href={e.features_source} rel="noopener" target="_blank" title="Listed on the organizer's site">{FEATURES[f][0]} {FEATURES[f][1]}</a>)}</div>}
  {e.note && <p class="muted" style="margin:.4rem 0 0">{e.note}</p>}
  {e.celtic_vendors && <p style="margin:.4rem 0 0;font-size:.92rem">🏴 {e.celtic_vendors}</p>}
  <p style="margin:.55rem 0 0;font-size:.92rem"><a href={e.source_url} rel="noopener" target="_blank">{e.source_kind === 'official' ? 'Official site' : 'Association listing'} ↗</a></p>
</article>
<style>
  .ev { border-top:5px solid var(--ginger); }
  .feat { background:#e3ebf5; color:var(--navy); text-decoration:none; }
  .ev-date { font-weight:700; color:var(--ginger); font-size:.95rem; }
</style>
