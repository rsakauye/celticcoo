---
import { calendarLinks } from '../lib/calendar.js';
import { u } from '../lib/site.js';
const { e, compact = false } = Astro.props;
const site = Astro.site ? Astro.site.href : 'https://celticcoo.ca/';
const links = e ? calendarLinks(e, { site }) : null;
const icsHref = links ? u(`events/${e.id}.ics`) : '';
---
{links && (
  <nav class:list={['add-cal', { compact }]} aria-label={`Add ${e.name} to your calendar`}>
    {compact ? (
      <span class="add-cal-label">Add to calendar</span>
    ) : (
      <p class="muted add-cal-note">
        {links.timeSkipped
          ? 'A start time had no timezone we could place, so this is saved as an all-day event.'
          : links.allDay
            ? 'Saved as an all-day event, from the first day through the last.'
            : `Times are in ${links.timeZone}.`}
        {' '}The .ics file opens in Apple Calendar and other calendar apps.
      </p>
    )}
    <a href={icsHref}>Download .ics</a>
    <a href={links.google} rel="noopener noreferrer" target="_blank">Google Calendar <span class="sr-only">(opens in a new tab)</span>↗</a>
    <a href={links.outlook} rel="noopener noreferrer" target="_blank">Outlook <span class="sr-only">(opens in a new tab)</span>↗</a>
  </nav>
)}
<style>
  .add-cal { display: flex; flex-wrap: wrap; gap: .35rem .5rem; align-items: center; margin: .2rem 0 .4rem; max-width: 100%; }
  .add-cal-label, .add-cal-note { flex-basis: 100%; }
  .add-cal-label { font-size: .85rem; color: var(--muted); }
  .add-cal-note { margin: 0 0 .15rem; }
  .add-cal a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: .35rem .7rem;
    border-radius: 10px;
    border: 2px solid var(--green);
    color: var(--green);
    background: transparent;
    text-decoration: none;
    font-weight: 600;
    font-size: .95rem;
    white-space: nowrap;
  }
  .add-cal a:hover { background: var(--cream); }
  .add-cal.compact { margin: .55rem 0 0; }
  .add-cal.compact a { font-size: .88rem; padding: .3rem .55rem; }
</style>
