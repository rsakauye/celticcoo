---
import { u } from '../lib/site.js';
import { defaultTartan } from '../lib/ceilidhTartans.js';
const strip = u(defaultTartan().fling);
const head = u('coo.svg');
---
<div class="coo-perch" data-ceilidh-coo>
  <button type="button" class="coo-bring" data-coo-toggle aria-pressed="false" aria-label="Bring out Ceilidh to dance to Highland Laddie">
    <span class="coo-head" data-coo-head><img src={head} alt="" width="48" height="48" /></span>
    <span class="coo-window">
      <span class="coo-nudge">
        <span class="coo-shift">
          <span class="coo-strip">
            <img src={strip} alt="" width="640" height="64" data-ceilidh-dance />
          </span>
        </span>
      </span>
    </span>
    <span class="coo-cue" aria-hidden="true"><span class="coo-cue-in" data-coo-tune>Highland Laddie</span><span class="coo-cue-out"><span class="coo-stop">stop</span> <span class="coo-tune-out" data-coo-tune>Highland Laddie</span></span></span>
  </button>
  <span class="sr-only" data-coo-status aria-live="polite"></span>
</div>

<script>
  import { MASTER_GAIN, VOICES, midiToHz } from '../lib/cooSynth.js';
  import { DANCE_TUNES, nextTuneIndex, prepareTune } from '../lib/danceTunes.js';
  import { TITLE, prepareTheme } from '../lib/cooTheme.js';
  import { createHeadNudge } from '../lib/headNudge.js';

  const root = document.querySelector('[data-ceilidh-coo]');
  // /tune/ sets this so the fixed corner coo cannot cover that page's buttons.
  if (root && document.documentElement.hasAttribute('data-hide-corner-coo')) root.remove();
  const button = root && root.isConnected && root.querySelector('[data-coo-toggle]');
  const status = root && root.isConnected && root.querySelector('[data-coo-status]');
  if (button && root && root.isConnected) {
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    // First play is Highland Laddie. Stop and start moves through the traditional
    // tunes, then the Coo theme, then back. The index is memory only.
    let tuneIndex = 0;
    let active = prepareTune(tuneIndex);
    let ctx = null;
    let master = null;
    let melodyBus = null;
    let bassBus = null;
    let playing = false;
    let cursor = 0;
    let timer = 0;
    const live = new Set();

    function cooThemeSelected() {
      return tuneIndex === DANCE_TUNES.length;
    }

    function tuneName() {
      return cooThemeSelected() ? TITLE : DANCE_TUNES[tuneIndex].title;
    }

    function showTune() {
      const name = tuneName();
      for (const el of root.querySelectorAll('[data-coo-tune]')) el.textContent = name;
      return name;
    }

    function setUi(on) {
      const name = showTune();
      button.setAttribute('aria-pressed', on ? 'true' : 'false');
      if (cooThemeSelected()) {
        button.setAttribute('aria-label', on ? 'Tuck Ceilidh away and stop Coo theme' : 'Bring out Ceilidh to dance');
      } else {
        button.setAttribute('aria-label', on ? `Tuck Ceilidh away and stop ${name}` : `Bring out Ceilidh to dance to ${name}`);
      }
      if (status) {
        status.textContent = on
          ? `Ceilidh is out and dancing. ${name} is playing.`
          : `Ceilidh is tucked away. ${name} is next, and the music is muted.`;
      }
    }

    function tone(bus, type, midi, time, dur, peak) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      const attack = Math.min(0.012, dur / 4);
      const release = Math.min(0.045, dur / 3);
      const sustainEnd = Math.max(attack, dur - release);
      osc.type = type;
      osc.frequency.setValueAtTime(midiToHz(midi), time);
      gain.gain.setValueAtTime(0.0001, time);
      gain.gain.linearRampToValueAtTime(peak, time + attack);
      gain.gain.linearRampToValueAtTime(peak, time + sustainEnd);
      gain.gain.linearRampToValueAtTime(0.0001, time + dur);
      osc.connect(gain);
      gain.connect(bus);
      osc.start(time);
      osc.stop(time + dur + 0.02);
      live.add(osc);
      osc.onended = () => live.delete(osc);
    }

    function scheduleCycle(when) {
      const tune = active.expanded;
      const step = active.step;
      for (const ev of tune.melody) {
        if (!ev.midi) continue;
        tone(melodyBus, VOICES.melody.type, ev.midi, when + ev.at * step, ev.steps * step, VOICES.melody.gain);
      }
      for (const ev of tune.bass) {
        if (!ev.midi) continue;
        tone(bassBus, VOICES.bass.type, ev.midi, when + ev.at * step, ev.steps * step, VOICES.bass.gain);
      }
      return when + active.cycleSeconds;
    }

    function pump() {
      if (!playing || !ctx) return;
      if (ctx.state === 'suspended' || ctx.state === 'interrupted') ctx.resume();
      if (cursor < ctx.currentTime - 0.05) cursor = ctx.currentTime + 0.02;
      const horizon = ctx.currentTime + 0.45;
      while (cursor < horizon) cursor = scheduleCycle(cursor);
      timer = window.setTimeout(pump, 120);
    }

    function silence() {
      playing = false;
      window.clearTimeout(timer);
      if (!ctx || !master) return;
      const now = ctx.currentTime;
      master.gain.cancelScheduledValues(now);
      master.gain.setValueAtTime(Math.max(master.gain.value, 0.0001), now);
      master.gain.linearRampToValueAtTime(0.0001, now + 0.04);
      for (const osc of live) {
        try { osc.stop(now + 0.05); } catch (e) { /* already ended */ }
      }
      live.clear();
    }

    function buildGraph() {
      master = ctx.createGain();
      master.gain.value = 0.0001;
      const filter = ctx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.value = 2800;
      filter.Q.value = 0.6;
      melodyBus = ctx.createGain();
      melodyBus.connect(filter);
      filter.connect(master);
      bassBus = ctx.createGain();
      bassBus.connect(master);
      master.connect(ctx.destination);
    }

    // A one-sample buffer started in the gesture unlocks older iOS audio sessions.
    function unlock() {
      const buffer = ctx.createBuffer(1, 1, ctx.sampleRate || 22050);
      const src = ctx.createBufferSource();
      src.buffer = buffer;
      src.connect(ctx.destination);
      src.start(0);
    }

    function loadActive() {
      active = cooThemeSelected() ? prepareTheme() : prepareTune(tuneIndex);
    }

    function startTune() {
      if (!AudioCtx) return false;
      // A second start replaces the tune that is already sounding.
      if (playing) silence();
      // Created here, on the tap, never on load and never from storage.
      if (!ctx) {
        ctx = new AudioCtx();
        buildGraph();
      }
      // iOS leaves a new context suspended. resume() has to run in this turn,
      // and the notes have to be scheduled here too. Waiting on the promise
      // drops the gesture, and the phone stays silent.
      ctx.resume();
      unlock();
      const now = ctx.currentTime;
      master.gain.cancelScheduledValues(now);
      master.gain.setValueAtTime(0.0001, now);
      master.gain.linearRampToValueAtTime(MASTER_GAIN, now + 0.03);
      playing = true;
      cursor = now + 0.02;
      pump();
      return true;
    }

    function bringOut() {
      root.setAttribute('data-out', '');
      let heard = false;
      try { heard = startTune(); } catch (e) { silence(); }
      const name = showTune();
      button.setAttribute('aria-pressed', 'true');
      button.setAttribute('aria-label', cooThemeSelected() ? 'Tuck Ceilidh away and stop Coo theme' : `Tuck Ceilidh away and stop ${name}`);
      if (status) {
        status.textContent = heard
          ? `Ceilidh is out and dancing. ${name} is playing.`
          : 'Ceilidh is out and dancing. Sound is not available in this browser.';
      }
    }

    function tuck() {
      silence();
      root.removeAttribute('data-out');
      if (tuneIndex === DANCE_TUNES.length) tuneIndex = 0;
      else if (tuneIndex === DANCE_TUNES.length - 1) {
        tuneIndex = nextTuneIndex(tuneIndex);
        tuneIndex = DANCE_TUNES.length;
      } else {
        tuneIndex = nextTuneIndex(tuneIndex);
      }
      loadActive();
      setUi(false);
    }

    const headEl = root.querySelector('[data-coo-head]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || document.documentElement.getAttribute('data-a11y-motion') === 'reduce';
    const nudge = createHeadNudge({
      reducedMotion,
      initiallyHidden: document.hidden,
      now: () => Date.now(),
      schedule: (fn, ms) => window.setTimeout(fn, ms),
      cancel: (id) => window.clearTimeout(id),
      onShake() {
        if (!headEl) return;
        headEl.classList.remove('coo-head-shake');
        void headEl.offsetWidth;
        headEl.classList.add('coo-head-shake');
        headEl.dispatchEvent(new Event('coo-head-shake'));
      },
    });
    if (headEl) headEl.addEventListener('animationend', () => headEl.classList.remove('coo-head-shake'));
    const phone = window.matchMedia('(max-width: 719px)');
    const armHead = () => { if (phone.matches) nudge.start(); };
    armHead();
    phone.addEventListener('change', armHead);
    document.addEventListener('visibilitychange', () => nudge.setHidden(document.hidden));

    button.addEventListener('click', () => {
      nudge.stop();
      if (root.hasAttribute('data-out')) tuck();
      else bringOut();
    });
  }
</script>

<style>
  :global(html[data-hide-corner-coo]) .coo-perch { display: none !important; }
  :global(html[data-hide-corner-coo] body) { padding-bottom: 0 !important; }
  :global(html:has([data-ceilidh-coo])) {
    --coo-frame: 128px;
    --coo-edge: calc(12px + env(safe-area-inset-right, 0px));
    --coo-gutter: max(0px, calc((100vw - 1100px) / 2));
    --coo-pad: max(1.1rem, calc(max(var(--coo-frame), 8.5rem) + var(--coo-edge) + 8px - var(--coo-gutter)));
  }
  :global(main.wrap:has([data-ceilidh-coo])),
  :global(body:has([data-ceilidh-coo]) footer.site .wrap) {
    padding-right: var(--coo-pad);
  }
  .coo-perch {
    --frame: var(--coo-frame, 128px);
    --peek-w: 30px;
    --peek-h: 44px;
    --peek-x: -74px;
    --peek-y: -2px;
    position: fixed;
    z-index: 25;
    top: auto;
    left: auto;
    right: var(--coo-edge, calc(12px + env(safe-area-inset-right, 0px)));
    bottom: calc(0.35rem + env(safe-area-inset-bottom, 0px));
    pointer-events: none;
  }
  .coo-perch :global(.sr-only) {
    left: 0;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .coo-bring {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: .28rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    touch-action: manipulation;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }
  .coo-bring:focus { outline: none; }
  .coo-bring:focus-visible {
    outline: 3px solid var(--focus, #1d3557);
    outline-offset: 3px;
    border-radius: 12px;
  }
  .coo-cue {
    flex: none;
    max-width: 9.5rem;
    background: var(--card, #fffdf8);
    color: var(--green, #1f4d3a);
    border: 2px solid var(--green, #1f4d3a);
    border-radius: 999px;
    font: 700 .72rem/1.2 system-ui, sans-serif;
    letter-spacing: .02em;
    text-align: right;
    padding: .32rem .5rem;
    box-shadow: 0 1px 0 rgba(42, 29, 20, .12);
    user-select: none;
  }
  .coo-cue-out { display: none; }
  .coo-head {
    display: none;
    flex: none;
    width: 48px;
    height: 48px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--card, #fffdf8);
    border: 2px solid var(--green, #1f4d3a);
    box-shadow: 0 2px 8px rgba(42, 29, 20, .22);
  }
  .coo-head img { display: block; width: 100%; height: 100%; }
  .coo-head.coo-head-shake { animation: coo-head-shake .6s ease-in-out; }
  @keyframes coo-head-shake {
    0%, 100% { transform: rotate(0deg); }
    30% { transform: rotate(-7deg); }
    60% { transform: rotate(6deg); }
    80% { transform: rotate(-3deg); }
  }
  @keyframes coo-appear {
    from { transform: scale(.55); }
    to { transform: scale(1); }
  }
  .coo-window {
    flex: none;
    width: var(--peek-w);
    height: var(--peek-h);
    max-width: calc(100vw - 32px - env(safe-area-inset-right, 0px));
    overflow: hidden;
    clip-path: inset(0);
    contain: paint;
    transition: width .42s ease, height .42s ease;
  }
  .coo-nudge, .coo-shift, .coo-strip { display: block; }
  .coo-shift {
    transform: translate3d(var(--peek-x), var(--peek-y), 0);
    transition: transform .42s ease;
  }
  .coo-strip { width: calc(var(--frame) * 10); height: var(--frame); }
  .coo-strip img {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
  /* Tucked: a small bob so the horn at the corner reads as alive. */
  .coo-perch:not([data-out]) .coo-nudge {
    animation: coo-wiggle 1.8s ease-in-out infinite;
  }
  /*
    The footer dance animated background-position with steps() and a `to`-only
    keyframe, while background-size lived in the background shorthand. iOS
    WebKit (mobile Brave) keeps painting the first frame for that combination.
    Slide the strip with an explicit from and to instead. steps(10, end) holds
    frames 0–9 and never the blank past the end of the strip.
  */
  .coo-perch[data-out] .coo-window { width: var(--frame); height: var(--frame); }
  .coo-perch[data-out] .coo-shift { transform: translate3d(0, 0, 0); }
  .coo-perch[data-out] .coo-strip { animation: coo-fling-2x 1s steps(10, end) infinite; }
  .coo-perch[data-out] .coo-cue {
    min-width: 2.75rem;
    min-height: 2.75rem;
    display: grid;
    place-items: center;
    padding: .3rem .55rem;
    background: var(--green, #1f4d3a);
    color: var(--cream, #f4e6c8);
    border-color: var(--cream, #f4e6c8);
  }
  .coo-perch[data-out] .coo-cue-in { display: none; }
  .coo-perch[data-out] .coo-cue-out { display: block; }
  @keyframes coo-wiggle {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(-4px, 0, 0); }
  }
  @keyframes coo-fling-2x {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-1280px, 0, 0); }
  }
  @keyframes coo-fling-3x {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-1920px, 0, 0); }
  }
  /*
    Phones: no right gutter. Idle is the round head from the logo, fully on
    screen. The dancing strip and its pill stay hidden until a tune starts.
    Bottom padding matches whichever of them is showing, so the end of the
    page can scroll clear of the browser bar and the home indicator.
  */
  @media (max-width: 719px) {
    :global(html:has([data-ceilidh-coo])) {
      --coo-frame: 88px;
      --coo-edge: calc(8px + env(safe-area-inset-right, 0px));
      --coo-pad: 1.1rem;
      --coo-head: 48px;
      --coo-pill: 2.75rem;
      --coo-gap: 12px;
      --coo-bottom: calc(8px + env(safe-area-inset-bottom, 0px));
      --coo-bottom: calc(8px + env(safe-area-inset-bottom, 0px) + max(0px, 100lvh - 100dvh));
    }
    .coo-perch {
      right: var(--coo-edge);
      bottom: var(--coo-bottom);
      max-width: calc(100dvw - var(--coo-edge));
    }
    .coo-perch:not([data-out]) .coo-head { display: block; }
    .coo-perch:not([data-out]) .coo-window,
    .coo-perch:not([data-out]) .coo-cue { display: none; }
    .coo-perch[data-out] .coo-head { display: none; }
    .coo-perch[data-out] .coo-window { animation: coo-appear .35s ease; }
    .coo-perch[data-out] .coo-strip { animation-name: coo-fling-phone; }
  }
  @keyframes coo-fling-phone {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(calc(var(--frame) * -10), 0, 0); }
  }
  :global(body:has([data-ceilidh-coo])) {
    padding-bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
  }
  :global(body:has([data-ceilidh-coo][data-out])) {
    padding-bottom: calc(var(--coo-frame, 128px) + 5.5rem + env(safe-area-inset-bottom, 0px));
  }
  @media (max-width: 719px) {
    :global(body:has([data-ceilidh-coo])) {
      padding-bottom: calc(var(--coo-head) + var(--coo-gap) + var(--coo-bottom));
    }
    :global(body:has([data-ceilidh-coo][data-out])) {
      padding-bottom: calc(var(--coo-frame) + var(--coo-pill) + .28rem + var(--coo-gap) + var(--coo-bottom));
    }
  }
  @media (min-width: 720px) {
    :global(html:has([data-ceilidh-coo])) { --coo-frame: 192px; }
    .coo-perch {
      --peek-w: 70px;
      --peek-h: 88px;
      --peek-x: -84px;
      --peek-y: 0px;
    }
    .coo-perch[data-out] .coo-strip { animation-name: coo-fling-3x; }
  }
  /* After the size query, so a wide screen still holds the standing frame. */
  @media (prefers-reduced-motion: reduce) {
    .coo-nudge, .coo-strip, .coo-head, .coo-window { animation: none !important; }
    .coo-window, .coo-shift { transition: none !important; }
  }
  :global(html[data-a11y-space=on]) .coo-bring { padding: 0; }
</style>
