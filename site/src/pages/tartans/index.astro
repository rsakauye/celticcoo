---
import Base from '../../layouts/Base.astro';
import { groups } from '../../lib/data.js';
import { u } from '../../lib/site.js';
// Link-out tartan finder. Each name links to its A-Z listing on the Scottish Register of Tartans.
const CLANS = ['Anderson','Armstrong','Baird','Bruce','Buchanan','Cameron','Campbell','Chisholm','Colquhoun','Cunningham','Davidson','Donald','Douglas','Elliot','Erskine','Farquharson','Ferguson','Forbes','Fraser','Gordon','Graham','Grant','Gunn','Hamilton','Hay','Henderson','Hunter','Innes','Johnston','Keith','Kerr','Lamont','Leslie','Lindsay','Logan','MacBeth','MacDonald','MacDougall','MacFarlane','MacFie','MacGregor','MacInnes','MacIntyre','MacKay','MacKenzie','MacKinnon','MacLachlan','MacLean','MacLennan','MacLeod','MacMillan','MacNab','MacNeil','MacPherson','MacRae','Maxwell','Menzies','Montgomery','Morrison','Munro','Murray','Ogilvie','Robertson','Ross','Scott','Sinclair','Stewart','Sutherland','Urquhart','Wallace'];
const azUrl = (n) => `https://www.tartanregister.gov.uk/az.aspx?searchString=${encodeURIComponent(n)}`;
const norm = (s) => s.toLowerCase().replace(/^mc/, 'mac').replace(/[^a-z]/g, '');
const ALIAS = { MacDonald: 'Donald', MacGregor: 'Gregor' };
const clanData = CLANS.map((c) => {
  const word = new RegExp(`\\b(${c}|${ALIAS[c] || c})\\b`, 'i');
  const soc = groups.find((g) => g.kind === 'Clan society' && word.test(g.name));
  return { name: c, key: norm(c), az: azUrl(c), society: soc ? { name: soc.name, url: soc.website } : null };
});
---
<Base title="Find your family tartan" description="Look up your surname or clan and find its tartans on the official Scottish Register of Tartans, plus clan societies in Canada.">
  <h1>Find your family tartan</h1>
  <p>Type your surname or clan to see its tartans on the official <a href="https://www.tartanregister.gov.uk/" rel="noopener" target="_blank">Scottish Register of Tartans ↗</a>, and whether there's a clan society in Canada you can join.</p>

  <form class="card finder" onsubmit="return false">
    <label for="t-name"><b>Surname or clan</b></label>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.3rem">
      <input id="t-name" list="t-clans" placeholder="e.g. MacLeod, Fraser, Campbell" autocomplete="off" style="flex:1;min-width:220px" />
      <datalist id="t-clans">{clanData.map((c) => <option value={c.name} />)}</datalist>
      <button class="btn" id="t-go" type="submit">Find tartans</button>
    </div>
    <div id="t-out" aria-live="polite" style="margin-top:.8rem"></div>
  </form>

  <h2 id="banner">The page stripe</h2>
  <p>The stripe across the top of every page is <b>Fraser of Lovat</b>. The Lovat Frasers of Beauly, the clan behind the Calgary Frasers band name. Ceilidh wears the same tartan by default. The button beside her lists eight kilts, each with its meaning. The sprites are simplified pixel versions.</p>

  <h2>Do I need a clan to wear tartan?</h2>
  <p>No. Anyone can wear a <b>district or national</b> tartan, and many provinces and cities have their own. Clan tartans are traditionally worn by people with that surname or a family link, but most clan societies are happy to see anyone wear theirs respectfully. A few tartans are restricted, such as royal or personal ones, so check the Register's notes. See <a href={u('what-to-wear/')}>what to wear</a> for more.</p>

  <script type="application/json" id="t-data" set:html={JSON.stringify(clanData)} />
  <script is:inline>
    (function () {
      var data = JSON.parse(document.getElementById('t-data').textContent);
      var $ = function (id) { return document.getElementById(id); };
      var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      function norm(s) { return s.toLowerCase().replace(/^mc/, 'mac').replace(/[^a-z]/g, ''); }
      function find() {
        var raw = $('t-name').value.trim(); if (!raw) { $('t-out').innerHTML = ''; return; }
        var k = norm(raw), hit = data.find(function (c) { return c.key === k; });
        var name = hit ? hit.name : raw.replace(/[^\p{L}' -]/gu, '').slice(0, 40);
        var az = 'https://www.tartanregister.gov.uk/az.aspx?searchString=' + encodeURIComponent(name);
        var html = '<p style="margin:0 0 .4rem"><a class="btn ghost" href="' + az + '" target="_blank" rel="noopener">See ' + esc(name) + ' tartans on the Scottish Register ↗</a></p>';
        if (hit && hit.society) html += '<p style="margin:.3rem 0">🛡️ Clan society in Canada: <a href="' + esc(hit.society.url) + '" target="_blank" rel="noopener">' + esc(hit.society.name) + ' ↗</a></p>';
        if (!hit) html += '<p class="muted" style="margin:.3rem 0">Not a clan name we know. Your surname may be a sept (associated family) of a clan, so a clan society can tell you. Try <a href="https://www.tartanregister.gov.uk/search.aspx" target="_blank" rel="noopener">the Register\'s full search ↗</a>.</p>';
        $('t-out').innerHTML = html;
      }
      $('t-go').addEventListener('click', find);
    })();
  </script>
</Base>
<style>
  .finder { max-width:720px; }
</style>
