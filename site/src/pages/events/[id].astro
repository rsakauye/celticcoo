---
// One page per confirmed event, so each event has its own URL and Event structured data (Google requires a leaf page).
import Base from '../../layouts/Base.astro';
import AddToCalendar from '../../components/AddToCalendar.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import BookLink from '../../components/BookLink.astro';
import { bookingConfig } from '../../lib/booking.js';
import EventCard from '../../components/EventCard.astro';
import { events, CATEGORY_EMOJI, COUNTRY_FLAG, FEATURES, sourceLinkLabel, dateConfirmLine, TAG_LABEL } from '../../lib/data.js';
import { eventJsonLd } from '../../lib/eventLd.js';
import { u } from '../../lib/site.js';
export function getStaticPaths() {
  return events.map((e) => ({ params: { id: e.id }, props: { e } }));
}
const { e } = Astro.props;
const place = [e.city, e.regionLabel, e.country !== 'Canada' && e.country !== e.regionLabel ? e.country : ''].filter(Boolean).join(', ');
const pageTitle = `${e.name}: ${e.when}, ${e.city}`;
const description = e.source_kind === 'organizer'
  ? `${e.name} (${e.type}) in ${place}, ${e.when}. Date from the host.`
  : `${e.name} (${e.type}) in ${place}, ${e.when}. Date confirmed on the ${e.source_kind === 'official' ? "organizer's" : "association's"} website, with the official link and similar events nearby.`;
const eventLd = eventJsonLd(e);
const hosts = (Array.isArray(e.organizer) ? e.organizer : e.organizer ? [e.organizer] : []).filter((o) => o && o.name);
const acts = (Array.isArray(e.performers) ? e.performers : e.performers ? [e.performers] : []).map((p) => (typeof p === 'string' ? { name: p } : p)).filter((p) => p && p.name);
const ticketUrl = e.offers && e.offers.url;
const ticketIsSource = ticketUrl && ticketUrl === e.source_url;
const saleWhen = (iso) => new Date(String(iso).slice(0, 10) + 'T12:00:00Z').toLocaleDateString('en-CA', { timeZone: 'UTC', month: 'long', day: 'numeric', year: 'numeric' });
const sourceLabel = ticketIsSource ? 'Tickets' : sourceLinkLabel(e.source_kind);
const summaryFrom = e.source_kind === 'organizer' ? 'host' : (e.source_kind === 'official' ? "organizer's page" : "association's page");
const near = events.filter((x) => x.id !== e.id && x.region === e.region && x.country === e.country).slice(0, 6);
const sameType = events.filter((x) => x.id !== e.id && x.category === e.category && !near.includes(x)).slice(0, 3);
---
<Base title={pageTitle} crumb={e.name} breadcrumbs={[['Events', 'events/']]} description={description} jsonld={eventLd}>
  <p class="muted"><a href={u('events/')}>Events</a> › <a href={u(`events/?country=${encodeURIComponent(e.country)}&region=${encodeURIComponent(e.region)}`)}>{e.regionLabel}</a></p>
  <h1>{e.name}</h1>
  <p class="when">{e.when}</p>
  <p>{COUNTRY_FLAG[e.country] || ''} {place}</p>
  <p><span class="pill green">{CATEGORY_EMOJI[e.category]} {e.category}</span>{e.cost === 'free' && <span class="pill free" title={e.cost_quote || undefined}>FREE</span>}{e.type !== e.category && <span class="pill">{e.type}</span>}{e.source_kind === 'organizer' && <span class="pill">Date from organizer</span>}</p>
  {e.summary && <p class="ev-sum">{e.summary} <span class="muted">(From the {summaryFrom}.)</span></p>}
  {e.tags && e.tags.length > 0 && <p>Tags: {e.tags.map((t) => <a class="pill tag" href={u(`events/?tags=${t}`)}>{TAG_LABEL[t] || t}<span class="sr-only">: see all events with this tag</span></a>)}</p>}
  {e.features && e.features.length > 0 && <p>At the games: {e.features.map((f) => <a class="pill" style="background:#e3ebf5;color:var(--navy);text-decoration:none" href={e.features_source} rel="noopener" target="_blank">{FEATURES[f][0]} {FEATURES[f][1]}</a>)} <span class="muted">(from the organizer's site)</span></p>}
  {e.note && <p>{e.note}</p>}
  {hosts.length > 0 && <p>Hosted by {hosts.map((o, i) => <>{i > 0 && (i === hosts.length - 1 ? ' and ' : ', ')}{o.url ? <a href={o.url} rel="noopener" target="_blank">{o.name}</a> : o.name}</>)}.</p>}
  {acts.length > 0 && <p>On the bill: {acts.map((p, i) => <>{i > 0 && (i === acts.length - 1 ? ' and ' : ', ')}{p.url ? <a href={p.url} rel="noopener" target="_blank">{p.name}</a> : p.name}</>)}.</p>}
  {e.celtic_vendors && <p>🏴 {e.celtic_vendors}</p>}
  <p>
    <a class="btn" href={e.source_url} rel="noopener" target="_blank">{sourceLabel} ↗</a>
    {ticketUrl && !ticketIsSource && <a class="btn" href={ticketUrl} rel="noopener" target="_blank" style="margin-left:.5rem">Tickets ↗</a>}
  </p>
  <section class="card save-event" aria-labelledby="save-heading">
    <h2 id="save-heading">Save this event</h2>
    <AddToCalendar e={e} />
    <NewsletterForm reminders={true} event={e} />
  </section>
  <aside class="card book-cta">
    <p>{bookingConfig.eventCta}</p>
    <BookLink eventId={e.id} name={e.name} button={true} />
  </aside>
  {e.offers?.availability === 'InStock' && <p class="muted">Tickets are on sale.</p>}
  {e.offers?.availability === 'SoldOut' && <p class="muted">Tickets are sold out.</p>}
  {e.offers?.availability === 'PreOrder' && <p class="muted">Tickets are available to pre-order.</p>}
  {e.offers?.validFrom && e.offers.availability !== 'InStock' && <p class="muted">Tickets go on sale {saleWhen(e.offers.validFrom)}.</p>}
  {e.cost === 'free' && <p class="muted">Free admission (per the organizer). <a href={e.cost_source || e.source_url} rel="noopener" target="_blank">Source ↗</a></p>}
  {e.cost === 'paid' && !(e.offers && e.offers.price !== undefined && e.offers.priceCurrency) && <p class="muted">Ticketed. See organizer for prices.</p>}
  {e.offers && e.offers.price !== undefined && e.offers.priceCurrency && !(e.cost === 'free' && Number(e.offers.price) === 0) && <p class="muted">{Number(e.offers.price) === 0 ? 'Admission is free.' : `Lowest published ticket price: ${e.offers.price} ${e.offers.priceCurrency}.`}</p>}
  <p class="muted">{dateConfirmLine(e.source_kind)} Dates and details can change, so check with the organizer before you travel. The links above add this event. Subscribe to every confirmed event with <a href={u('events.ics')}>events.ics</a>.</p>
  <p class="muted">Going? See <a href={u('what-to-wear/')}>what to wear</a>, find <a href={u('groups/')}>clubs &amp; lessons</a> or <a href={u('shops/')}>Celtic shops</a>{e.category === 'Burns Night' && <>, or read our <a href={u('burns-night/')}>Burns Night guide</a></>}.</p>
  {near.length > 0 && <section><h2>More in {e.regionLabel}</h2><div class="grid">{near.map((x) => <EventCard e={x} />)}</div></section>}
  {sameType.length > 0 && <section><h2>More {e.category.toLowerCase()} events</h2><div class="grid">{sameType.map((x) => <EventCard e={x} />)}</div></section>}
  <p><a href={u('events/')}>← All Celtic &amp; Highland events</a></p>
</Base>
<style>
  .ev-sum { font-size:1.08rem; max-width:44rem; }
  .save-event { margin: 1rem 0; }
  .save-event h2 { margin: .1rem 0 .55rem; font-size: 1.45rem; }
  .book-cta { background:#fff4e8; border-color:#f1cfae; margin:1rem 0; }
  .book-cta p { margin:.1rem 0 .7rem; }
  .tag { text-decoration:underline; text-underline-offset:2px; }
  .when { font-weight:700; color:var(--ginger); font-size:1.15rem; margin:.2rem 0; }
</style>
