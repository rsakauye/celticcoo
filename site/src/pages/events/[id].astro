---
// One page per confirmed event, so each event has its own URL and Event structured data (Google requires a leaf page).
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { events, CATEGORY_EMOJI, COUNTRY_FLAG, FEATURES } from '../../lib/data.js';
import { u } from '../../lib/site.js';
export function getStaticPaths() {
  return events.map((e) => ({ params: { id: e.id }, props: { e } }));
}
const { e } = Astro.props;
const ORIGIN = 'https://celticcoo.ca';
const COUNTRY_CODE = { Canada: 'CA', USA: 'US', UK: 'GB', France: 'FR' };
const CURRENCY = { Canada: 'CAD', USA: 'USD', UK: 'GBP', France: 'EUR' };
const place = [e.city, e.regionLabel, e.country !== 'Canada' && e.country !== e.regionLabel ? e.country : ''].filter(Boolean).join(', ');
const pageTitle = `${e.name}: ${e.when}, ${e.city}`;
const description = `${e.name} (${e.type}) in ${place}, ${e.when}. Date confirmed on the ${e.source_kind === 'official' ? "organizer's" : "association's"} website, with the official link and similar events nearby.`;
const eventLd = {
  '@context': 'https://schema.org', '@type': 'Event', name: e.name,
  startDate: e.start_date, endDate: e.end_date,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: e.city, address: { '@type': 'PostalAddress', addressLocality: e.city, addressRegion: e.region, ...(COUNTRY_CODE[e.country] ? { addressCountry: COUNTRY_CODE[e.country] } : {}) } },
  description: [e.type, e.note].filter(Boolean).join('. '),
  url: `${ORIGIN}/events/${e.id}/`,
  sameAs: e.source_url,
  // No per-event photos yet, so every event uses the site's real share image (never generated art).
  image: [`${ORIGIN}/og.png`],
  // Organizer and performers only where our data names them (see events_2027.json); otherwise left out.
  ...(e.organizer ? { organizer: e.organizer.map((o) => ({ '@type': 'Organization', ...o })) } : {}),
  ...(e.performers ? { performer: e.performers.map((name) => ({ '@type': 'PerformingGroup', name })) } : {}),
  // Info/ticket link on the organizer's own page. No price: we never publish one we haven't seen.
  ...(e.source_kind === 'official' || e.organizer ? { offers: { '@type': 'Offer', url: e.source_url, priceCurrency: CURRENCY[e.country] || 'CAD', availability: 'https://schema.org/InStock', ...(e.tickets_on_sale ? { validFrom: e.tickets_on_sale } : {}) } } : {}),
};
const TAG_LABEL = { 'highland-games': 'Highland Games', 'pipe-band': 'Pipe bands', 'highland-dance': 'Highland dance', 'scottish-country-dance': 'Scottish country dance', ceilidh: 'Ceilidh', burns: 'Burns', 'st-andrews': "St Andrew's", music: 'Music', 'heavy-events': 'Heavy events', 'ball-formal': 'Ball / formal', 'workshop-class': 'Workshops & classes', irish: 'Irish', 'family-friendly': 'Family-friendly', other: 'Other' };
const near = events.filter((x) => x.id !== e.id && x.region === e.region && x.country === e.country).slice(0, 6);
const sameType = events.filter((x) => x.id !== e.id && x.category === e.category && !near.includes(x)).slice(0, 3);
---
<Base title={pageTitle} crumb={e.name} breadcrumbs={[['Events', 'events/']]} description={description} jsonld={eventLd}>
  <p class="muted"><a href={u('events/')}>Events</a> › <a href={u(`events/?country=${encodeURIComponent(e.country)}&region=${encodeURIComponent(e.region)}`)}>{e.regionLabel}</a></p>
  <h1>{e.name}</h1>
  <p class="when">{e.when}</p>
  <p>{COUNTRY_FLAG[e.country] || ''} {place}</p>
  <p><span class="pill green">{CATEGORY_EMOJI[e.category]} {e.category}</span>{e.type !== e.category && <span class="pill">{e.type}</span>}</p>
  {e.summary && <p class="ev-sum">{e.summary} <span class="muted">(From the {e.source_kind === 'official' ? "organizer's" : "association's"} page.)</span></p>}
  {e.tags && e.tags.length > 0 && <p>Tags: {e.tags.map((t) => <a class="pill tag" href={u(`events/?tags=${t}`)}>{TAG_LABEL[t] || t}<span class="sr-only">: see all events with this tag</span></a>)}</p>}
  {e.features && e.features.length > 0 && <p>At the games: {e.features.map((f) => <a class="pill" style="background:#e3ebf5;color:var(--navy);text-decoration:none" href={e.features_source} rel="noopener" target="_blank">{FEATURES[f][0]} {FEATURES[f][1]}</a>)} <span class="muted">(from the organizer's site)</span></p>}
  {e.note && <p>{e.note}</p>}
  {e.celtic_vendors && <p>🏴 {e.celtic_vendors}</p>}
  <p><a class="btn" href={e.source_url} rel="noopener" target="_blank">{e.source_kind === 'official' ? 'Official site' : 'Association listing'} ↗</a></p>
  <p class="muted">We confirmed this date on the {e.source_kind === 'official' ? "organizer's" : "association's"} own website. Dates and details can change, so check with the organizer before you travel. Add every confirmed event to your calendar with <a href={u('events.ics')}>events.ics</a>.</p>
  <p class="muted">Going? See <a href={u('what-to-wear/')}>what to wear</a>, find <a href={u('groups/')}>clubs &amp; lessons</a> or <a href={u('shops/')}>Celtic shops</a>{e.category === 'Burns Night' && <>, or read our <a href={u('burns-night/')}>Burns Night guide</a></>}.</p>
  {near.length > 0 && <section><h2>More in {e.regionLabel}</h2><div class="grid">{near.map((x) => <EventCard e={x} />)}</div></section>}
  {sameType.length > 0 && <section><h2>More {e.category.toLowerCase()} events</h2><div class="grid">{sameType.map((x) => <EventCard e={x} />)}</div></section>}
  <p><a href={u('events/')}>← All Celtic &amp; Highland events</a></p>
</Base>
<style>
  .ev-sum { font-size:1.08rem; max-width:44rem; }
  .tag { text-decoration:underline; text-underline-offset:2px; }
  .when { font-weight:700; color:var(--ginger); font-size:1.15rem; margin:.2rem 0; }
</style>
