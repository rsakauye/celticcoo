---
import Base from '../../layouts/Base.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
---
<Base title="The Coo's Letter" description="A short email every two weeks of Celtic and Highland events in Canada.">
  <div class="card" style="max-width:640px">
    <h1>The Coo's Letter</h1>
    <p>Every second Tuesday: what's on in the next few weeks, newly announced dates, a featured shop or maker, and a Gaelic word to try out.</p>
    <p>Want a reminder for one event as well? Open that event and choose <b>Email me event reminders</b>.</p>
    <NewsletterForm />
  </div>
</Base>
