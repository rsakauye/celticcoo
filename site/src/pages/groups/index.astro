---
import Base from '../../layouts/Base.astro';
import { groups, featuredGroup, counts, GROUP_EMOJI } from '../../lib/data.js';
import { groupSearchText } from '../../lib/groupFilters.js';
import { u } from '../../lib/site.js';
const provs = [...new Set(groups.map((g) => g.province))].map((p) => ({ p, label: groups.find((g) => g.province === p).regionLabel }));
const kinds = [...new Set(groups.map((g) => g.kind))].sort();
---
<Base title="Celtic clubs, pipe bands & lessons in Canada" description="Find a pipe band, Highland dance school, clan society, Gaelic class, Scottish country dance group or Burns club near you, and who offers lessons.">
  <h1>Clubs &amp; lessons</h1>
  <p>Pipe bands, Highland and Scottish country dance, clan societies, Gaelic classes, Burns clubs, heavy events, trad sessions, whisky societies and more: <b>{counts.groups}</b> groups across Canada, <b>{counts.groupsLessons}</b> of them offering lessons. Every website was checked on Oct 17–18, 2026. Ask the group directly about schedules and fees.</p>

  {featuredGroup && (
    <aside class="card featured" id={`featured-${featuredGroup.id}`} data-prov={featuredGroup.province} data-kind={featuredGroup.kind} data-lessons={featuredGroup.lessons ? 'y' : 'n'} data-search={groupSearchText(featuredGroup)}>
      <span class="pill tba">⭐ Featured in Alberta</span>
      <h2 style="margin:.3rem 0">{featuredGroup.name}</h2>
      <p style="margin:.2rem 0">Calgary youth pipe band and living-history program in the 1757 uniform of the 78th Fraser Highlanders. Members learn piping, drumming, music theory, drill, history and Highland dance, and travel every second year to events in places like Inverness, Louisbourg, Quebec City and Montreal. Practices are on Sundays in Calgary, and new members are interviewed in September.</p>
      <p style="margin:.4rem 0 0"><a href={featuredGroup.website} rel="noopener" target="_blank">Visit the Youth Squad's page ↗</a> · Part of the <a href="https://78fraserscalgary.ca/" rel="noopener" target="_blank">Fort Calgary Garrison ↗</a> · <a href={u(`groups/${featuredGroup.id}/`)}>View profile</a></p>
    </aside>
  )}

  <form class="filters card" onsubmit="return false">
    <label>Province<br /><select id="g-prov"><option value="">All</option>{provs.map((x) => <option value={x.p}>{x.label}</option>)}</select></label>
    <label>Type<br /><select id="g-kind"><option value="">All types</option>{kinds.map((k) => <option value={k}>{GROUP_EMOJI[k]} {k}</option>)}</select></label>
    <div class="g-search">
      <label for="g-q">Search<span class="sr-only"> by name, city, province, type, or note</span></label>
      <span class="g-search-field">
        <input id="g-q" type="search" placeholder="Name, city, province…" autocomplete="off" enterkeyhint="search" autocapitalize="off" spellcheck="false" aria-controls="g-list" />
        <button type="button" class="g-clear" id="g-clear" hidden aria-label="Clear search"><span aria-hidden="true">×</span></button>
      </span>
    </div>
    <label style="align-self:end"><input type="checkbox" id="g-lessons" /> Offers lessons</label>
    <span style="align-self:end"><button type="button" class="btn ghost small" id="g-clans">🛡️ Clan societies ({counts.clans})</button></span>
    <div class="muted" id="g-count" style="align-self:end" aria-live="polite" aria-atomic="true"></div>
  </form>

  <div class="grid" id="g-list">
    {groups.map((g) => (
      <a class="card grp" id={g.id} href={u(`groups/${g.id}/`)} data-prov={g.province} data-kind={g.kind} data-lessons={g.lessons ? 'y' : 'n'} data-search={groupSearchText(g)} aria-label={`${g.name}. View profile`}>
        <span class="pill green">{GROUP_EMOJI[g.kind]} {g.kind}</span>
        {g.lessons && <span class="pill tba">🎓 Lessons</span>}
        <h3>{g.name}</h3>
        <div class="muted">📍 {g.city && g.city !== 'National' ? `${g.city}, ` : ''}{g.regionLabel}</div>
        {g.type.toLowerCase() !== g.kind.toLowerCase() && <p class="muted" style="margin:.3rem 0 0;font-size:.85rem">{g.type}</p>}
        {g.note && <p style="margin:.35rem 0 0;font-size:.92rem">{g.note}</p>}
        <span class="view">View profile →</span>
      </a>
    ))}
  </div>
  <p id="g-empty" class="card" hidden><span id="g-empty-text">No groups match yet.</span> <button type="button" class="btn ghost small" id="g-empty-clear" hidden>Clear search</button> Know one? <a href={u('submit/')}>Tell us about it</a>.</p>

  <aside class="card" style="margin-top:2rem">
    <b>Want to try heavy events?</b> The <a href="https://www.csaf.ca/page/contact-us" rel="noopener" target="_blank">CSAF lists practice contacts ↗</a> across Canada, including Calgary and Edmonton. Whisky societies are for adults of legal drinking age only.<br /><br />
    <b>Run a band, dance school, society, session or class?</b> Listings are free. <a href={u('submit/')}>Add or update your group</a>. We list organizations only, never members' or students' names.
  </aside>
  <script>
    import { visibleMatches, filtersFromSearch, searchFromFilters } from '../../lib/groupFilters.js';
    const $ = (id) => document.getElementById(id);
    const prov = $('g-prov'), kind = $('g-kind'), les = $('g-lessons'), qInput = $('g-q');
    const clearBtn = $('g-clear'), emptyClear = $('g-empty-clear');
    const featured = document.querySelector('.featured');
    const initial = filtersFromSearch(location.search);
    if (initial.province) prov.value = initial.province;
    if (initial.kind) kind.value = initial.kind;
    les.checked = initial.lessons;
    if (initial.q) qInput.value = initial.q;

    const cardOf = (el) => ({
      province: el.dataset.prov,
      kind: el.dataset.kind,
      lessons: el.dataset.lessons,
      search: el.dataset.search,
    });
    let timer = 0;
    const syncClear = () => { clearBtn.hidden = qInput.value.length === 0; };
    function revealAll() {
      document.querySelectorAll('.grp').forEach((el) => { el.hidden = false; });
      if (featured) featured.hidden = false;
      const empty = $('g-empty');
      if (empty) empty.hidden = true;
    }
    function apply() {
      // The input event and ?q= on load both end here. A throw shows every card.
      try {
        const filters = { province: prov.value, kind: kind.value, lessons: les.checked, q: qInput.value };
        const cards = [...document.querySelectorAll('.grp')];
        const show = visibleMatches(cards.map(cardOf), filters);
        let n = 0;
        cards.forEach((el, i) => {
          const ok = show[i] !== false;
          el.hidden = !ok;
          if (ok) n += 1;
        });
        if (featured) featured.hidden = visibleMatches([cardOf(featured)], filters)[0] === false;
        $('g-count').textContent = n + (n === 1 ? ' group' : ' groups');
        const q = filters.q.trim();
        $('g-empty').hidden = n > 0;
        $('g-empty-text').textContent = q ? `No groups match “${q}”.` : 'No groups match those filters yet.';
        emptyClear.hidden = !q;
        syncClear();
        try { history.replaceState(null, '', location.pathname + searchFromFilters(filters) + location.hash); } catch (e) {}
      } catch (e) {
        revealAll();
      }
    }
    const runNow = () => { clearTimeout(timer); apply(); };
    [prov, kind, les].forEach((el) => el.addEventListener('change', runNow));
    qInput.addEventListener('input', () => { syncClear(); clearTimeout(timer); timer = setTimeout(apply, 200); });
    qInput.addEventListener('search', runNow);
    qInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && qInput.value) { e.preventDefault(); qInput.value = ''; runNow(); }
    });
    const clearSearch = () => { qInput.value = ''; runNow(); qInput.focus(); };
    clearBtn.addEventListener('click', clearSearch);
    emptyClear.addEventListener('click', clearSearch);
    $('g-clans').addEventListener('click', () => { kind.value = 'Clan society'; prov.value = ''; les.checked = false; runNow(); });
    apply();
  </script>
</Base>
<style>
  .featured { margin:1.2rem 0; background:#fff4e8; border-color:#f1cfae; border-left:6px solid var(--ginger); }
  .filters { display:flex; flex-wrap:wrap; gap:.8rem 1.2rem; margin:1rem 0; position:sticky; top:0; z-index:5; box-shadow:0 4px 12px rgba(60,30,10,.06); }
  .filters label { font-size:.85rem; color:var(--muted); }
  .filters select { min-width:180px; margin-top:.15rem; }
  .g-search { flex:1 1 220px; min-width:180px; font-size:.85rem; color:var(--muted); }
  .g-search-field { position:relative; display:block; margin-top:.15rem; }
  .g-search-field input { width:100%; min-width:0; margin:0; padding-right:2.1rem; }
  .g-search-field input::-webkit-search-cancel-button,
  .g-search-field input::-webkit-search-decoration { -webkit-appearance:none; appearance:none; display:none; }
  .g-clear { position:absolute; top:50%; right:.2rem; transform:translateY(-50%); display:grid; place-items:center; width:1.7rem; height:1.7rem; margin:0; padding:0; border:0; border-radius:6px; background:transparent; color:var(--muted); font:700 1.15rem/1 system-ui,sans-serif; cursor:pointer; }
  .g-clear[hidden] { display:none !important; }
  .g-clear:hover, .g-clear:focus-visible { color:var(--fg); background:var(--cream); }
  #g-empty-clear { margin:0 .35rem; }
  html[data-a11y-space=on] .g-clear { width:2.75rem; height:2.75rem; min-height:0; padding:0; }
  html[data-a11y-space=on] .g-search-field input { padding-right:3.2rem; }
  @media (max-width:640px) { .filters { position:static; } .g-search { flex-basis:100%; } }
  .btn.small { padding:.35rem .7rem; font-size:.9rem; }
  a.grp { display:flex; flex-direction:column; height:100%; border-left:5px solid var(--navy); color:var(--fg); text-decoration:none; }
  a.grp[hidden] { display:none !important; }
  a.grp h3 { margin:.3rem 0 .25rem; font-size:1.08rem; }
  a.grp:hover, a.grp:focus-visible { border-color:var(--ginger); }
  a.grp .view { margin-top:auto; padding-top:.75rem; text-align:right; color:var(--ginger); font-weight:700; font-size:.92rem; }
  a.grp:hover .view, a.grp:focus-visible .view { text-decoration:underline; text-underline-offset:2px; }
</style>
