---
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/site.js';
import { defaultTartan } from '../../lib/ceilidhTartans.js';
import { DEFAULT_LOW_A, DEFAULT_OUTPUT_LEVEL, PRESETS, STEPS } from '../../lib/droneTuner.js';
const strip = u(defaultTartan().fling);
const ears = u(defaultTartan().ears);
const TABS = [
  { id: 'steps', label: 'Steps' },
  { id: 'low-a', label: 'Low A' },
  { id: 'volume', label: 'Volume' },
  { id: 'help', label: 'Help' },
];
---
<Base title="Tune the drones" noindex={true} hideCornerCoo={true} description="An on-device Highland bagpipe drone tuner. The microphone stays on your phone. Nothing is sent or saved.">
  <div class="tune" data-tuner>
    <header class="tune-head">
      <p class="kicker">A wee tuner for the drones</p>
      <h1>Artificial intelligence. Tuning the drones anyway.</h1>
    </header>

    <!-- Everything needed while playing sits in this block, so a phone shows it
         without scrolling. Reference, volume and help live in the tabs below. -->
    <div class="stage" data-readout data-zone="none">
      <div class="meter-wrap">
        <div
          class="tune-scale"
          data-meter
          data-zone="none"
          data-dir="locked"
          role="meter"
          aria-valuemin={-50}
          aria-valuemax={50}
          aria-valuenow="0"
          aria-valuetext="No pitch yet"
          aria-label="Cents from the nearest drone"
        >
          <div class="zones" aria-hidden="true">
            <span class="z off"></span>
            <span class="z close"></span>
            <span class="z good"></span>
            <span class="z close"></span>
            <span class="z off"></span>
          </div>
          <div class="strobe" aria-hidden="true"><div class="strobe-move" data-strobe></div></div>
          <div class="needle" data-needle></div>
        </div>
        <p class="scale-labels" aria-hidden="true"><span>Flat</span><span>In tune</span><span>Sharp</span></p>
      </div>

      <div class="tune-coo" data-tune-coo data-mood="wait">
        <div class="tune-window">
          <div class="tune-strip">
            <img src={strip} alt="" width="640" height="64" data-ceilidh-dance />
          </div>
          <div class="tune-wince">
            <img src={ears} alt="" width="256" height="64" data-ceilidh-ears />
          </div>
        </div>
      </div>

      <div class="nums">
        <p class="tune-cents slot">
          <span class="slot-sizer" aria-hidden="true">888.8 cents sharp</span>
          <span data-cents-text>No pitch yet</span>
        </p>
        <p class="tune-hz slot">
          <span class="slot-sizer" aria-hidden="true">888.8 Hz · Chanter low A · target 888.8 Hz</span>
          <span><span data-hz>—</span> · <span data-target>Sound a tenor or the bass</span></span>
        </p>
        <p class="mood slot">
          <span class="slot-sizer" aria-hidden="true">Ceilidh has her hooves over her ears. Still a way off.</span>
          <span data-mood-text>Ceilidh is waiting for a drone.</span>
        </p>
      </div>

      <p class="advice slot">
        <span class="slot-sizer" aria-hidden="true">Sound a drone. The meter will say which way to move the tuning slide.</span>
        <span data-advice>Sound a drone. The meter will say which way to move the tuning slide.</span>
      </p>
      <p class="beat slot">
        <span class="slot-sizer" aria-hidden="true">8.8 beats per second. Beats slowing means getting closer. No wobble means locked.</span>
        <span data-beat>When two drones sound together, their beats show up here.</span>
      </p>
    </div>

    <div class="demo-panel card" data-demo-panel hidden>
      <label class="slider" for="detune">Detune the second tenor
        <input id="detune" data-detune type="range" min="-40" max="40" step="0.1" value="28" aria-describedby="detune-out demo-hint" />
      </label>
      <output id="detune-out" class="slot" for="detune">
        <span class="slot-sizer" aria-hidden="true">40.0 cents sharp</span>
        <span data-detune-out>28 cents sharp</span>
      </output>
      <p id="demo-hint" class="muted">One tenor is already in tune. The other follows this slider. Drag it to the middle and the meter, the beats, and Ceilidh should all settle.</p>
    </div>

    <p class="err" data-error role="alert" hidden></p>

    <!-- On a phone this bar is fixed to the bottom edge, inside thumb reach. -->
    <div class="actions tune-actions">
      <button type="button" class="btn" data-start>Start tuning</button>
      <button type="button" class="btn ghost" data-demo>Try demo</button>
      <button type="button" class="btn ghost" data-ear>Tune by ear</button>
    </div>

    <div class="sheet card">
      <div class="tabs" role="tablist" aria-label="Tuner options" data-tabs>
        {TABS.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            aria-controls={`panel-${tab.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? '0' : '-1'}
            data-tab={tab.id}
          >{tab.label}</button>
        ))}
      </div>

      <section class="panel" role="tabpanel" id="panel-steps" aria-labelledby="tab-steps" tabindex="0" data-panel="steps">
        <ol class="step-chips" aria-label="Order of tuning">
          {STEPS.map((step, i) => (
            <li>
              <button type="button" data-step={i} aria-current={i === 0 ? 'step' : 'false'}>
                <span aria-hidden="true">{i + 1}</span>
                <span class="sr-only">Step {i + 1}: {step.title}</span>
              </button>
            </li>
          ))}
        </ol>
        <div class="step-now">
          <p class="step-count">Step <span data-step-num>1</span> of {STEPS.length}</p>
          <h2 class="step-title" data-step-title>{STEPS[0].title}</h2>
          <p class="step-body" data-step-body>{STEPS[0].body}</p>
        </div>
        <div class="step-nav">
          <button type="button" class="btn ghost" data-step-prev aria-disabled="true">Back</button>
          <button type="button" class="btn ghost" data-step-next>Next step</button>
        </div>
      </section>

      <section class="panel" role="tabpanel" id="panel-low-a" aria-labelledby="tab-low-a" tabindex="0" data-panel="low-a" hidden>
        <p class="muted">Tenor drones tune to half of the chanter's low A. The bass tunes to a quarter. Default is 480 Hz.</p>
        <div class="presets" role="group" aria-label="Low A presets, in hertz">
          {PRESETS.map((hz) => (
            <button type="button" class="preset" data-preset={hz} aria-pressed={hz === DEFAULT_LOW_A ? 'true' : 'false'}>{hz}</button>
          ))}
        </div>
        <div class="custom-row">
          <label for="low-a">Custom hertz</label>
          <input id="low-a" data-low-a type="number" inputmode="decimal" min="430" max="510" step="0.1" value={DEFAULT_LOW_A} aria-describedby="low-a-err" />
          <button type="button" class="btn ghost" data-capture>Set from chanter</button>
        </div>
        <p id="low-a-err" class="field-err" data-low-a-err hidden>Use a number from 430 to 510.</p>
        <p class="capture" data-capture-note>Play a steady low A for 2 seconds. The page locks whatever pitch it hears.</p>
      </section>

      <section class="panel" role="tabpanel" id="panel-volume" aria-labelledby="tab-volume" tabindex="0" data-panel="volume" hidden>
        <label class="slider" for="level">Volume
          <input id="level" data-level type="range" min="0" max="100" value={DEFAULT_OUTPUT_LEVEL} aria-describedby="volume-hint" />
        </label>
        <p id="volume-hint" class="muted">Demo and by-ear use this slider. If the phone is on silent, these tones stay quiet until silent mode is off or the volume is up.</p>
      </section>

      <section class="panel help" role="tabpanel" id="panel-help" aria-labelledby="tab-help" tabindex="0" data-panel="help" hidden>
        <p>A robot on a wall once claimed the drones were beyond it. This page listens on your phone, counts the cents, and tells you which way to slide. The pipes stay in the room.</p>
        <h2>Which way to slide</h2>
        <p>The top section is the tuning slide. Slide the top section up. A longer drone sounds lower. Slide the top section down. A shorter drone sounds higher.</p>
        <p>Green is within 3 cents. Amber is within 10. Past that the meter is red. When two drones are sounding, beats slowing means getting closer. No wobble means locked.</p>
        <h2>By-ear mode</h2>
        <p>Off until you tap Tune by ear. It plays a reed-like reference: a tenor at low A / 2 and a bass at low A / 4, made on this device when you tap the button. Match your drones to it by ear.</p>
        <p>Use one earbud for the reference drone, so you can still hear your pipes. The tuner asks for the phone's microphone when it can see a headset, but iOS can still switch to the earbud mic.</p>
        <h2>Privacy</h2>
        <p>Microphone audio is analyzed on your device only. Nothing is sent or saved. Echo cancellation, noise suppression, and automatic gain stay off, so the phone does not treat a drone like a voice.</p>
      </section>
    </div>
    <p class="privacy-line muted">The microphone stays on your phone. Nothing is sent or saved.</p>
    <p class="sr-only" data-live aria-live="polite"></p>
  </div>
</Base>

<script>
  import { mountTuner } from '../../lib/droneTunerPage.js';
  mountTuner(document.querySelector('[data-tuner]'));
</script>

<style>
  /* Mobile first. The base rules are the phone layout; wider screens add to it. */
  .tune { max-width: 760px; }
  .tune-head { margin: 0 0 .6rem; }
  .tune h1 { font-size: clamp(1.25rem, 5.4vw, 2.15rem); margin: 0; }
  .kicker { display: none; color: var(--ginger); font-weight: 700; font-style: italic; margin: 0 0 .15rem; font-size: .92rem; }

  .stage {
    display: grid;
    grid-template-columns: var(--frame) minmax(0, 1fr);
    grid-template-areas:
      "meter meter"
      "coo   nums"
      "advice advice"
      "beat  beat";
    gap: .35rem .75rem;
    align-items: start;
  }
  .meter-wrap { grid-area: meter; }
  .tune-coo { grid-area: coo; }
  .nums { grid-area: nums; min-width: 0; }
  .advice { grid-area: advice; }
  .beat { grid-area: beat; }

  .stage, .tune-coo { --frame: 64px; }
  .tune-window {
    position: relative;
    width: var(--frame);
    height: var(--frame);
    margin: 0 auto;
    overflow: hidden;
  }
  .tune-strip { width: calc(var(--frame) * 10); height: var(--frame); }
  .tune-wince {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--frame) * 4);
    height: var(--frame);
    visibility: hidden;
  }
  .tune-strip img, .tune-wince img {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
  /* Dance stays on the 10-frame strip. The wince is its own 4-frame strip
     (120 ms each), slid with translate3d and explicit from/to keyframes.
     iOS WebKit does not paint a steps() background-position animation.
     The sprite is drawn at whole multiples of its 64px frame (1x, 2x, 3x)
     so the pixels stay square. */
  .tune-coo[data-mood="dance"] .tune-strip { animation: tune-fling-1x 1s steps(10, end) infinite; }
  .tune-coo[data-mood="wince"] .tune-strip { visibility: hidden; }
  .tune-coo[data-mood="wince"] .tune-wince {
    visibility: visible;
    animation: tune-wince-1x .48s steps(4, end) infinite;
  }

  .tune-scale {
    --cents: 0;
    position: relative;
    height: 3.6rem;
    border: 2px solid var(--green);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
  }
  .zones { display: grid; grid-template-columns: 40fr 7fr 6fr 7fr 40fr; height: 100%; }
  .z.off { background: repeating-linear-gradient(135deg, #e7b2aa, #e7b2aa 6px, #f6d4ce 6px, #f6d4ce 12px); }
  .z.close { background: #f6ddb0; }
  .z.good { background: #b7dfc8; }
  .strobe { position: absolute; inset: 0; overflow: hidden; pointer-events: none; opacity: .28; }
  .strobe-move {
    height: 100%;
    width: 200%;
    background: repeating-linear-gradient(90deg, transparent 0 10px, rgba(29, 21, 14, .75) 10px 14px);
    animation: tune-strobe 1s linear infinite;
    animation-play-state: paused;
  }
  .tune-scale[data-dir="sharp"] .strobe-move,
  .tune-scale[data-dir="flat"] .strobe-move { animation-play-state: running; }
  .tune-scale[data-dir="flat"] .strobe-move { animation-direction: reverse; }
  .needle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    margin-left: -2px;
    background: #1a120c;
    box-shadow: 0 0 0 1px #fff;
  }
  .needle::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 11px solid #1a120c;
  }
  .scale-labels { display: flex; justify-content: space-between; margin: .2rem .1rem 0; font-size: .82rem; font-weight: 700; color: var(--muted); }

  .tune-cents { margin: 0; font: 800 clamp(1.45rem, 7vw, 2.7rem)/1.05 Georgia, serif; color: var(--green); }
  .stage[data-zone="close"] .tune-cents { color: #7a4e0d; }
  .stage[data-zone="off"] .tune-cents { color: #8d2a2a; }
  .tune-hz { margin: .1rem 0 0; font-size: .88rem; line-height: 1.3; }
  .mood { margin: .1rem 0 0; font-size: .85rem; color: var(--muted); line-height: 1.3; }
  .advice { margin: .1rem 0 0; font-size: 1.05rem; line-height: 1.35; font-weight: 600; }
  .beat { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.35; }
  .slot { display: grid; align-items: start; }
  .slot > * { grid-area: 1 / 1; }
  .slot-sizer { visibility: hidden; }
  .tune-cents, .tune-hz, .demo-panel output { font-variant-numeric: tabular-nums; }

  .demo-panel { margin-top: .7rem; padding: .7rem .9rem; }
  .demo-panel output { display: grid; font-weight: 800; font-size: 1.15rem; margin: .1rem 0 .2rem; }
  .demo-panel .muted { margin: 0; }
  .slider { display: grid; gap: .25rem; font-weight: 700; }
  .slider input { width: 100%; min-height: 44px; }
  .err { color: #8d2a2a; font-weight: 700; margin: .6rem 0 0; }

  .tune-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin: .9rem 0 0; }
  .tune-actions .btn { min-height: 48px; }

  /* Tabs: one panel at a time instead of a long page of cards. */
  .sheet { margin-top: .7rem; padding: 0; overflow: hidden; }
  .tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
    background: var(--cream);
  }
  .tabs [role="tab"] {
    min-height: 44px;
    padding: .35rem .2rem;
    border: 0;
    border-bottom: 3px solid transparent;
    background: transparent;
    color: var(--muted);
    font: 700 .95rem system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    cursor: pointer;
  }
  .tabs [role="tab"][aria-selected="true"] {
    color: var(--green);
    background: var(--card);
    border-bottom-color: var(--ginger);
  }
  .tabs [role="tab"]:focus-visible { outline-offset: -4px; }
  .panel { padding: .7rem .9rem .9rem; }
  .panel:focus-visible { outline-offset: -4px; }
  .panel > :first-child { margin-top: 0; }
  .panel > :last-child { margin-bottom: 0; }

  .step-chips { list-style: none; margin: 0 0 .5rem; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .4rem; }
  .step-chips button {
    width: 100%;
    min-height: 44px;
    border: 2px solid var(--line);
    border-radius: 99px;
    background: #fff;
    color: var(--green);
    font: 700 1rem system-ui, sans-serif;
    cursor: pointer;
  }
  .step-chips button[aria-current="step"] { border-color: var(--green); background: var(--green); color: #fff; }
  .step-count { margin: 0; font-size: .85rem; font-weight: 700; color: var(--ginger); }
  .step-title { margin: .1rem 0 .2rem; font-size: 1.2rem; }
  .step-body { margin: 0; color: #4a3a2e; min-height: 4.2em; }
  .step-nav { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; margin-top: .7rem; }
  .step-nav .btn { min-height: 48px; }
  .step-nav .btn[aria-disabled="true"] { opacity: .45; cursor: default; }
  .step-nav .btn[aria-disabled="true"]:hover { background: transparent; color: var(--green); }

  .presets { display: grid; grid-template-columns: repeat(auto-fill, minmax(3.5rem, 1fr)); gap: .4rem; margin: .5rem 0 .7rem; }
  .preset {
    min-height: 48px;
    border: 2px solid var(--green);
    border-radius: 999px;
    background: #fff;
    color: var(--green);
    font: 700 1rem system-ui, sans-serif;
    cursor: pointer;
  }
  .preset[aria-pressed="true"] { background: var(--green); color: #fff; }
  .custom-row { display: grid; grid-template-columns: auto 6.5rem; gap: .5rem; align-items: center; }
  .custom-row label { font-weight: 700; }
  .custom-row input { width: 100%; min-height: 44px; font-size: 1rem; }
  .custom-row .btn { grid-column: 1 / -1; min-height: 48px; }
  .field-err { color: #8d2a2a; font-weight: 700; margin: .4rem 0 0; }
  .capture { margin: .55rem 0 0; min-height: 2.8em; }
  .help h2 { font-size: 1.15rem; margin: 1rem 0 .3rem; }
  .help p { margin: .3rem 0; }
  .privacy-line { margin: .6rem 0 0; text-align: center; }

  @keyframes tune-fling-1x {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-640px, 0, 0); }
  }
  @keyframes tune-fling-2x {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-1280px, 0, 0); }
  }
  @keyframes tune-fling-3x {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-1920px, 0, 0); }
  }
  @keyframes tune-wince-1x {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-256px, 0, 0); }
  }
  @keyframes tune-wince-2x {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-512px, 0, 0); }
  }
  @keyframes tune-wince-3x {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-768px, 0, 0); }
  }
  @keyframes tune-strobe {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-24px, 0, 0); }
  }

  /* Phones: the three main controls sit in a bar on the bottom edge. */
  @media (max-width: 719px) {
    .tune-actions {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      margin: 0;
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: .4rem;
      padding: .5rem 1.1rem calc(.5rem + env(safe-area-inset-bottom, 0px));
      background: var(--bg);
      border-top: 1px solid var(--line);
      box-shadow: 0 -8px 18px rgba(42, 29, 20, .08);
    }
    .tune-actions .btn { width: 100%; text-align: center; padding: .4rem .3rem; line-height: 1.2; }
  }

  /* Bigger phones in portrait and small tablets: the coo doubles. */
  @media (min-width: 480px) {
    .kicker { display: block; }
    .stage, .tune-coo { --frame: 128px; }
    .tune-coo[data-mood="dance"] .tune-strip { animation-name: tune-fling-2x; }
    .tune-coo[data-mood="wince"] .tune-wince { animation-name: tune-wince-2x; }
    .tune-scale { height: 4.4rem; }
  }

  @media (min-width: 720px) {
    .tune-head { margin-bottom: 1rem; }
    .stage, .tune-coo { --frame: 192px; }
    .stage {
      grid-template-areas:
        "coo meter"
        "coo nums"
        "coo advice"
        "coo beat";
      align-items: start;
      column-gap: 1.2rem;
    }
    .tune-coo[data-mood="dance"] .tune-strip { animation-name: tune-fling-3x; }
    .tune-coo[data-mood="wince"] .tune-wince { animation-name: tune-wince-3x; }
    .custom-row { grid-template-columns: auto 7rem auto; }
    .custom-row .btn { grid-column: auto; }
  }

  /* Phone held sideways: keep the meter and the readout side by side. */
  @media (max-height: 500px) and (orientation: landscape) {
    .tune-head .kicker { display: none; }
    .tune h1 { font-size: 1.15rem; }
    .stage {
      grid-template-columns: var(--frame) minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "meter meter meter"
        "coo nums advice"
        "coo nums beat";
    }
  }

  /* Small phone held sideways: the bottom bar would eat a fifth of the screen, so the
     controls move to a rail on the right edge and the page makes room for it. */
  @media (max-width: 719px) and (max-height: 500px) and (orientation: landscape) {
    .tune-actions {
      top: 0;
      left: auto;
      bottom: 0;
      right: 0;
      width: calc(9rem + env(safe-area-inset-right, 0px));
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      overflow-y: auto;
      padding: .5rem calc(.6rem + env(safe-area-inset-right, 0px)) .5rem .6rem;
      border-top: 0;
      border-left: 1px solid var(--line);
      box-shadow: -8px 0 18px rgba(42, 29, 20, .08);
    }
    :global(body:has([data-tuner])) {
      padding-bottom: 0 !important;
      padding-right: calc(9rem + env(safe-area-inset-right, 0px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tune-coo[data-mood="dance"] .tune-strip {
      animation: none !important;
      transform: translate3d(calc(var(--frame) * -2), 0, 0);
    }
    .tune-coo[data-mood="wince"] .tune-wince {
      animation: none !important;
      transform: translate3d(0, 0, 0);
    }
    .strobe-move, .needle { animation: none !important; transition: none !important; }
  }
  :global(html[data-a11y-motion=reduce]) .tune-coo[data-mood="dance"] .tune-strip {
    animation: none !important;
    transform: translate3d(calc(var(--frame) * -2), 0, 0);
  }
  :global(html[data-a11y-motion=reduce]) .tune-coo[data-mood="wince"] .tune-wince {
    animation: none !important;
    transform: translate3d(0, 0, 0);
  }
  :global(html[data-a11y-motion=reduce]) .strobe-move { animation: none !important; }
