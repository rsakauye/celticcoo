---
// Directory of performers who listed themselves for free.
// The page builds as static HTML with the filters, an empty list, and the
// "be the first" card already in place, so nothing jumps on first paint.
// functions/performers/index.js fills the list on the server from the listed
// rows in D1 (the same rows /api/performers returns), using the slots marked
// below (see src/lib/performerCards.js). There is no loading line and no
// client fetch. The inline script only filters cards that are already there.
import Base from '../../layouts/Base.astro';
import { COPY, listingConfig } from '../../lib/listing.js';
import { u } from '../../lib/site.js';

const C = COPY.performersPage;
const acts = listingConfig.performer.acts;
const provinces = listingConfig.provinces;
---
<Base title={C.title} crumb="Performers" description={C.description}>
  <h1>{C.title}</h1>
  {C.intro.map((p) => <p>{p}</p>)}
  <p><a class="btn" href={u('submit/#performers')}>{C.button}</a></p>

  <form class="filters card" id="pf-filters" onsubmit="return false">
    <label>{C.filterType}<br />
      <select id="pf-act" disabled data-pf-off><option value="">{C.filterAll}</option>{acts.map(([id, label]) => <option value={id}>{label}</option>)}</select>
    </label>
    <label>{C.filterProvince}<br />
      <select id="pf-prov" disabled data-pf-off><option value="">{C.filterAll}</option>{provinces.map(([id, label]) => <option value={id}>{label}</option>)}</select>
    </label>
    <div class="muted pf-count" id="pf-count" aria-live="polite" aria-atomic="true"><Fragment set:html="<!--pf:count-->" /></div>
  </form>

  <div class="grid" id="pf-list"><Fragment set:html="<!--pf:list-->" /></div>

  <div class="card" id="pf-empty">
    <p style="margin-top:0">{C.empty}</p>
    <a class="btn" href={u('submit/#performers')}>{C.button}</a>
  </div>
  <p class="card" id="pf-status" role="status" hidden>{C.loadFailed}</p>
  <p class="card" id="pf-nomatch" hidden>{C.noMatch}</p>

  <p class="muted small-print">{C.smallPrint}</p>

  <script is:inline>
    (function () {
      var list = document.getElementById('pf-list');
      var act = document.getElementById('pf-act');
      var prov = document.getElementById('pf-prov');
      var count = document.getElementById('pf-count');
      var nomatch = document.getElementById('pf-nomatch');
      if (!list || !act || !prov || !list.children.length) return;
      function apply() {
        var a = act.value, pr = prov.value, shown = 0;
        Array.prototype.forEach.call(list.children, function (c) {
          var ok = (!a || (' ' + c.getAttribute('data-acts') + ' ').indexOf(' ' + a + ' ') !== -1) && (!pr || c.getAttribute('data-prov') === pr);
          c.hidden = !ok;
          if (ok) shown += 1;
        });
        count.textContent = shown + (shown === 1 ? ' performer' : ' performers');
        nomatch.hidden = shown !== 0;
      }
      act.addEventListener('change', apply);
      prov.addEventListener('change', apply);
      if (act.value || prov.value) apply();
    })();
  </script>
</Base>
<style is:global>
  /* Global on purpose: the cards are rendered by functions/performers, outside Astro's scoped classes. */
  #pf-filters { display: flex; flex-wrap: wrap; gap: .8rem 1.2rem; margin: 1rem 0; }
  #pf-filters label { font-size: .85rem; color: var(--muted); }
  #pf-filters select { min-width: 180px; margin-top: .15rem; }
  #pf-filters select:disabled { opacity: .6; cursor: not-allowed; }
  .pf-count { align-self: end; min-height: 1.5em; }
  #pf-list:empty { display: none; }
  .pf .pills { display: flex; flex-wrap: wrap; gap: .3rem; }
  .pf-name { margin: .4rem 0 .2rem; font-size: 1.25rem; overflow-wrap: anywhere; }
  .pf-blurb { margin: .5rem 0; overflow-wrap: anywhere; white-space: pre-line; }
  .pf-facts { margin: .4rem 0; display: grid; grid-template-columns: max-content 1fr; gap: .15rem .6rem; font-size: .95rem; }
  .pf-facts dt { font-weight: 650; color: var(--muted); }
  .pf-facts dd { margin: 0; }
  .pf-links { margin: .4rem 0; overflow-wrap: anywhere; }
  .pf-actions { margin: .6rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .small-print { margin-top: 2rem; font-size: .92rem; }
  #pf-empty, #pf-status, #pf-nomatch { margin-top: 1rem; }
  .pf h2.pf-name { color: var(--green); }
</style>
