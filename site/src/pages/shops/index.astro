---
import Base from '../../layouts/Base.astro';
import ShopCard from '../../components/ShopCard.astro';
import { shops, regionName } from '../../lib/data.js';
import { u } from '../../lib/site.js';
const provinces = [...new Set(shops.map((s) => s.province))];
---
<Base title="Celtic shops & makers in Canada" description="Kilt shops, Highland dress, bagpipe makers, Highland dance supplies and Celtic gifts across Canada.">
  <h1>Celtic shops &amp; makers in Canada</h1>
  <p>Kilts, Highland dress, bagpipes, dance shoes, tartan and Celtic gifts, from big stores to one-person workshops. Many of them also have tents at the Highland Games.</p>
  <p class="muted">Jump to: {provinces.map((p, i) => <>{i > 0 && ' · '}<a href={`#prov-${p}`}>{regionName(p)}</a></>)} · <label><input type="checkbox" id="makers-only" /> Makers only</label> · <label><input type="checkbox" id="hire-only" /> Kilt hire</label> · <label><input type="checkbox" id="food-only" /> Scottish &amp; Irish food</label></p>
  {provinces.map((p) => (
    <section class="prov" id={`prov-${p}`}>
      <h2>{regionName(p)}</h2>
      <div class="grid">{shops.filter((s) => s.province === p).map((s) => <ShopCard s={s} />)}</div>
    </section>
  ))}
  <aside class="card" style="margin-top:2rem">
    <b>Own a Celtic shop or make something by hand?</b> Listings are free. <a href={u('submit/')}>Add your shop</a> or send us a correction.
  </aside>
  <script is:inline>
    (function () {
      var ids = ['makers-only', 'hire-only', 'food-only'];
      function apply() {
        var m = document.getElementById('makers-only').checked, h = document.getElementById('hire-only').checked, f = document.getElementById('food-only').checked;
        document.querySelectorAll('.prov').forEach(function (sec) {
          var shown = 0;
          sec.querySelectorAll('.shop').forEach(function (el) {
            el.hidden = (m && el.dataset.maker !== 'yes') || (h && el.dataset.hire !== 'yes') || (f && el.dataset.food !== 'yes');
            if (!el.hidden) shown++;
          });
          sec.hidden = shown === 0;
        });
      }
      ids.forEach(function (id) { document.getElementById(id).addEventListener('change', apply); });
    })();
  </script>
</Base>
