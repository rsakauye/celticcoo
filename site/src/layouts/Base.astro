---
import NewsletterForm from '../components/NewsletterForm.astro';
import { u, SITE_NAME } from '../lib/site.js';
import { bookingConfig } from '../lib/booking.js';
const { noindex = false, hideCornerCoo = false, breadcrumbs = null, jsonld = null, ogType = 'website', crumb = null, title = SITE_NAME, description = 'Highland Games, pipe bands, Highland dance, Gaelic and Celtic festivals across Canada, plus the shops and makers who keep the culture going.', ogTitle = '', ogDescription = '' } = Astro.props;
const fullTitle = title === SITE_NAME ? 'The Celtic Coo: Highland Games & Celtic events in Canada' : `${title} · The Celtic Coo`;
const shareTitle = ogTitle || fullTitle;
const shareDescription = ogDescription || description;
const path = Astro.url.pathname;
const nav = [['', 'Home'], ['events/', 'Events'], ['results/', 'Results'], ['groups/', 'Clubs & lessons'], ['burns-night/', 'Burns Night'], ['shops/', 'Shops'], ['fundraising/', 'Fundraising']];
const navNew = [['what-to-wear/', 'What to wear'], ['tartans/', 'Find your tartan'], ['roots/', 'Trace your roots'], ['about/', 'About Ceilidh']];
const navEnd = [['book/', bookingConfig.navLabel], ['submit/', 'Add yours']];
const tartanBg = `background-image:url(${u('tartan-fraser-of-lovat.svg')})`;
// SEO: canonical always points at the production domain (celticcoo.pages.dev is a duplicate host).
const ORIGIN = 'https://celticcoo.ca';
const BASE_URL = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const relPath = path.startsWith(BASE_URL) ? path.slice(BASE_URL.length) : path.replace(/^\//, '');
const canonical = `${ORIGIN}/${relPath}`;
const isProd = !Astro.site || Astro.site.host === 'celticcoo.ca';
const robots = noindex || !isProd ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const ogImage = `${ORIGIN}/og.png`;
const ld = [];
if (relPath === '') {
  ld.push({ '@context': 'https://schema.org', '@type': 'Organization', '@id': `${ORIGIN}/#org`, name: SITE_NAME, url: `${ORIGIN}/`, logo: `${ORIGIN}/og.png`, address: { '@type': 'PostalAddress', postOfficeBoxNumber: '1604', addressLocality: 'Okotoks', addressRegion: 'AB', postalCode: 'T1S 1B5', addressCountry: 'CA' } });
  ld.push({ '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${ORIGIN}/#website`, name: SITE_NAME, url: `${ORIGIN}/`, inLanguage: 'en-CA', publisher: { '@id': `${ORIGIN}/#org` } });
} else if (!noindex) {
  const crumbs = [[SITE_NAME, ''], ...(breadcrumbs || []), [crumb || title, relPath]];
  ld.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map(([name, p], i) => ({ '@type': 'ListItem', position: i + 1, name, item: `${ORIGIN}/${p}` })) });
}
if (jsonld) ld.push(...(Array.isArray(jsonld) ? jsonld : [jsonld]));
const ldJson = JSON.stringify(ld.length === 1 ? ld[0] : ld).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en-CA" {...(hideCornerCoo ? { 'data-hide-corner-coo': 'true' } : {})}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="en_CA" />
  <meta property="og:title" content={shareTitle} />
  <meta property="og:description" content={shareDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Ceilidh the Coo, The Celtic Coo's Highland coo mascot" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={shareTitle} />
  <meta name="twitter:description" content={shareDescription} />
  <meta name="twitter:image" content={ogImage} />
  {ld.length > 0 && <script type="application/ld+json" set:html={ldJson} />}
  <meta name="theme-color" content="#1f4d3a" />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" type="application/xml" href={u('sitemap.xml')} />
  <link rel="alternate" type="application/rss+xml" title="The Celtic Coo: upcoming events" href={u('rss.xml')} />
  <script is:inline define:vars={{ FONT: u('fonts/atkinson.css') }}>
    // Accessibility settings before first paint (saved choice, else the OS preference): no flash.
    (function(){var d=document.documentElement,s={};try{s=JSON.parse(localStorage.getItem('a11y')||'{}')||{}}catch(e){}function m(q){return!!(window.matchMedia&&matchMedia(q).matches)}d.setAttribute('data-a11y-size',s.size||'m');d.setAttribute('data-a11y-contrast',s.contrast||(m('(prefers-contrast: more)')?'high':'normal'));d.setAttribute('data-a11y-motion',s.motion||(m('(prefers-reduced-motion: reduce)')?'reduce':'full'));['font','cb','space','links','tables'].forEach(function(k){if(s[k]&&s[k]!=='default')d.setAttribute('data-a11y-'+k,s[k])});if(s.font==='readable'){var l=document.createElement('link');l.id='a11y-font';l.rel='stylesheet';l.href=FONT;document.head.appendChild(l)}})();
  </script>
  <style is:global>
    :root {
      --fg:#2a1d14; --muted:#6b5a4c; --bg:#fbf6ec; --card:#fffdf8; --line:#eadfcb;
      --green:#1f4d3a; --green2:#2f6b52; --ginger:#a54e1e; --ginger2:#e0843f; --cream:#f4e6c8; --navy:#1d3557;
      --focus:#1d3557; --focus-halo:#fff;
    }
    * { box-sizing:border-box; }
    body { margin:0; font:1.0625rem/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; color:var(--fg); background:var(--bg); }
    a { color:var(--green2); }
    h1,h2,h3 { font-family: Georgia, "Iowan Old Style", "Palatino Linotype", serif; line-height:1.2; color:var(--green); }
    h1 { font-size:2.1rem; margin:.3rem 0 .6rem; }
    h2 { font-size:1.5rem; margin:2rem 0 .7rem; }
    .wrap { max-width:1100px; margin:0 auto; padding:.8rem 1.1rem; }
    main.wrap { padding-top:1.4rem; padding-bottom:3rem; }
    /* tartan band: Fraser of Lovat, drawn by scripts/make_tartan.py */
    .tartan { height:10px; background:var(--green) 0 0 / 10px 10px repeat; }
    header.site { background:var(--green); color:#fff; }
    header.site .wrap { display:flex; flex-wrap:wrap; gap:.6rem 1.4rem; align-items:center; justify-content:space-between; }
    header.site a { color:#fff; text-decoration:none; }
    .brand { display:flex; align-items:center; gap:.6rem; font-family:Georgia,serif; font-size:1.35rem; font-weight:700; }
    .brand img { width:46px; height:46px; background:var(--cream); border-radius:50%; padding:3px; }
    .brand small { display:block; font:400 .78rem/1.1 system-ui,sans-serif; opacity:.8; letter-spacing:.02em; }
    header.site nav a { white-space:nowrap; display:inline-block; margin-right:1rem; opacity:.85; font-size:.97rem; padding:.2rem 0; border-bottom:2px solid transparent; }
    header.site nav a:hover, header.site nav a[aria-current="page"] { opacity:1; border-bottom-color:var(--ginger2); }
    .card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:1rem 1.1rem; }
    .grid { display:grid; gap:1rem; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); }
    .muted { color:var(--muted); font-size:.92rem; }
    .pill { display:inline-block; font-size:.78rem; padding:.08rem .55rem; border-radius:99px; background:var(--cream); color:#5a3a1e; margin:0 .25rem .25rem 0; white-space:nowrap; }
    .pill.green { background:#dcebe2; color:var(--green); }
    .pill.tba { background:#fde7d6; color:#8a3b0d; }
    .pill.free { background:#1f7a3a; color:#fff; font-weight:700; }
    .btn { display:inline-block; background:var(--ginger); color:#fff; border:0; border-radius:10px; padding:.6rem 1rem; font:600 1rem system-ui,sans-serif; text-decoration:none; cursor:pointer; }
    .btn:hover { background:#8a4118; }
    .btn.ghost { background:transparent; color:var(--green); border:2px solid var(--green); }
    input, select { font:inherit; padding:.5rem .6rem; border:1px solid #cdbda3; border-radius:8px; background:#fff; color:var(--fg); }
    footer.site { background:var(--green); color:#e9f1ec; margin-top:2rem; }
    footer.site a { color:#fff; }
    footer.site .wrap { display:flex; flex-wrap:wrap; gap:1.5rem 3rem; justify-content:space-between; padding-top:1.4rem; padding-bottom:1.6rem; font-size:.92rem; }
    footer.site .muted { color:#c7d8ce; }
    header.site nav { display:flex; flex-wrap:wrap; align-items:center; }
    details.more { position:relative; margin-right:1rem; font-size:.97rem; }
    details.more summary { cursor:pointer; opacity:.85; list-style:none; padding:.2rem 0; }
    details.more summary::after { content:" ▾"; font-size:.8em; }
    details.more[open] summary, details.more summary:hover { opacity:1; }
    details.more > div { position:absolute; z-index:20; top:100%; left:0; background:var(--green); border:1px solid #2f6b52; border-radius:10px; padding:.4rem .8rem; min-width:190px; box-shadow:0 8px 20px rgba(0,0,0,.2); }
    details.more > div a { display:block; margin:0; padding:.3rem 0; }
    .sr-only { position:absolute; left:-9999px; }
    /* ---------- Accessibility (WCAG 2.2 AA) + settings menu (public/a11y.js). Choices live in localStorage only. ---------- */
    .skip { position:absolute; left:.5rem; top:.5rem; transform:translateY(-200%); z-index:100; background:#fff; color:#000; padding:.6rem 1rem; border:3px solid #000; border-radius:6px; font-weight:700; text-decoration:underline; }
    .skip:focus { transform:none; }
    :focus-visible { outline:3px solid var(--focus); outline-offset:2px; box-shadow:0 0 0 5px var(--focus-halo); }
    main:focus { outline:none; box-shadow:none; }
    html[data-a11y-size=s] { font-size:87.5%; } html[data-a11y-size=l] { font-size:118.75%; } html[data-a11y-size=xl] { font-size:137.5%; }
    html[data-a11y-motion=reduce] *, html[data-a11y-motion=reduce] *::before, html[data-a11y-motion=reduce] *::after { animation:none !important; transition:none !important; scroll-behavior:auto !important; }
    html[data-a11y-links=on] a { text-decoration:underline !important; text-underline-offset:.15em; }
    html[data-a11y-space=on] body { line-height:1.8; letter-spacing:.03em; word-spacing:.1em; }
    html[data-a11y-space=on] p { margin-bottom:1.3em; }
    html[data-a11y-space=on] button, html[data-a11y-space=on] .btn, html[data-a11y-space=on] input, html[data-a11y-space=on] select { min-height:48px; padding:.65rem 1rem; }
    html[data-a11y-space=on] nav a, html[data-a11y-space=on] footer a, html[data-a11y-space=on] .a11y-link { display:inline-block; padding:.55rem .2rem; }
    html[data-a11y-font=readable] body, html[data-a11y-font=readable] body * { font-family:'Atkinson Hyperlegible', system-ui, sans-serif !important; }
    .a11y-table { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
    html[data-a11y-tables=on] .a11y-table { position:static; width:auto; height:auto; overflow:visible; clip:auto; white-space:normal; margin-top:.8rem; }
    .a11y-link { background:none; border:0; padding:0; color:inherit; text-decoration:underline; font:inherit; cursor:pointer; border-radius:0; }
    header.site :focus-visible, footer.site :focus-visible { outline-color:#fff; box-shadow:0 0 0 5px #000; }
    html[data-a11y-contrast=high] { --fg:#000; --muted:#1f1f1f; --bg:#fff; --card:#fff; --line:#000; --green:#0d2e22; --green2:#0b4a32; --ginger:#7a3510; }
    html[data-a11y-contrast=high] .card { border:2px solid #000; }
    html[data-a11y-contrast=high] .pill.free { background:#0d2e22; color:#fff; }
    html[data-a11y-contrast=high] a { text-decoration:underline; }
    html[data-a11y-contrast=high] header.site nav a, html[data-a11y-contrast=high] details.more summary { opacity:1; }
    html[data-a11y-contrast=high] footer.site .muted { color:#fff; }
    html[data-a11y-cb=on] { --green2:#005a9c; --ginger:#9a4a00; }
    /* menu skin: parchment card with a tartan band, like the site */
    #a11y-dlg { --a11y-bg:var(--card); --a11y-fg:var(--fg); --a11y-muted:#5a4a3d; --a11y-line:var(--line); --a11y-ctl:#8a7560; --a11y-ctl-bg:#fff; --a11y-on:var(--green); --a11y-on-fg:#fff; --a11y-focus:#1d3557; --a11y-border:3px solid var(--green); --a11y-radius:14px; --a11y-ctl-radius:10px; }
    #a11y-dlg .a11y-in { border-top:10px solid var(--green); background-image:linear-gradient(var(--green),var(--green)); background-size:100% 0; }
    #a11y-dlg h2 { font-family:Georgia,"Iowan Old Style",serif; color:var(--green); }
    html[data-a11y-contrast=high] #a11y-dlg { --a11y-muted:#000; --a11y-line:#000; --a11y-ctl:#000; }
  </style>
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <div class="tartan" aria-hidden="true" style={tartanBg}></div>
  <header class="site">
    <div class="wrap">
      <a class="brand" href={u('')}><img src={u('coo.svg')} alt="" width="46" height="46" /><span>The Celtic Coo<small>Celtic &amp; Highland life in Canada</small></span></a>
      <nav aria-label="Main">
        {nav.map(([p, label]) => <a href={u(p)} aria-current={path === u(p) ? 'page' : undefined}>{label}</a>)}
        <details class="more"><summary>New here?</summary><div>{navNew.map(([p, label]) => <a href={u(p)} aria-current={path === u(p) ? 'page' : undefined}>{label}</a>)}</div></details>
        {navEnd.map(([p, label]) => <a href={u(p)} aria-current={path === u(p) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
  <main class="wrap" id="main" tabindex="-1"><slot /></main>
  <footer class="site">
    <div class="tartan" aria-hidden="true" style={tartanBg}></div>
    <div class="wrap">
      <div style="max-width:420px">
        <b>The Coo's Letter</b> <span class="muted">· a short email every two weeks of what's on</span><br />
        <NewsletterForm compact={true} />
      </div>
      <div class="muted" style="max-width:460px">
        Dates come from organizers' and associations' websites and can change. Always confirm with the organizer before you travel.<br />
        <a href={u('events.ics')}>Calendar (ICS)</a> · <a href={u('rss.xml')}>RSS</a> · <a href={u('book/')}>{bookingConfig.navLabel}</a> · <a href={u('submit/')}>Add an event or shop</a> · <a href={u('about/')}>About</a> · <a href={u('sitemap.xml')}>Sitemap</a> · <a href={u('privacy/')}>Privacy</a> · <a href={u('terms/')}>Terms</a> · <button type="button" class="a11y-link" data-a11y-open aria-haspopup="dialog">Accessibility</button><br />
        Mascot: Ceilidh the Coo (say "Kaylee"), in the Fraser of Lovat tartan.<br />
        © {new Date().getFullYear()} The Celtic Coo · CelticCoo.ca
      </div>
    </div>
  </footer>
  <script is:inline src={u('a11y.js')} data-font={u('fonts/atkinson.css')} data-omit="tables" defer></script>
</body>
</html>
